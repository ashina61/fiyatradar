/* Note textarea counter */
document.addEventListener('input', e=>{
  if (e.target.matches('.note-grp textarea')){
    const c = document.getElementById('noteCt');
    if (c) c.textContent = e.target.value.length;
  }
});
function addNoteChip(btn){
  btn.classList.toggle('on');
  const ta = document.querySelector('.note-grp textarea');
  if (!ta) return;
  const t = btn.textContent.trim();
  const tagline = `[${t}] `;
  if (btn.classList.contains('on')){
    ta.value = tagline + ta.value;
  } else {
    ta.value = ta.value.replace(tagline, '');
  }
  const c = document.getElementById('noteCt');
  if (c) c.textContent = ta.value.length;
}

/* Toast */
function toast(msg, icon){
  const w = document.getElementById('toastWrap');
  const t = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = `<i class="fas ${icon||'fa-circle-info'}"></i> <span>${msg}</span>`;
  w.appendChild(t);
  setTimeout(()=>t.remove(), 2600);
}

function confirmLogout(){
