<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FiyatRadar V10 — Complete Working Prototype</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #1A1614;
            --bg-secondary: #24201D;
            --surface: #2A2522;
            --surface-alt: #312C29;
            --border: rgba(61, 54, 51, 0.4);
            --text-primary: rgba(250, 246, 242, 0.96);
            --text-secondary: rgba(210, 200, 190, 0.68);
            --text-subtle: rgba(201, 191, 184, 0.42);
            --tan: #C4A57B;
            --success: #8A9A8B;
            --success-bg: rgba(138, 154, 139, 0.1);
            --warning: #B58B7A;
            --danger: #A67B7B;
            --radius-md: 10px;
            --radius-lg: 14px;
            --radius-xl: 18px;
            --radius-full: 9999px;
            --shadow-md: 0 2px 6px rgba(0,0,0,0.18);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #E8E4DF 0%, #D4CFC7 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .phone-frame {
            width: 390px;
            height: 844px;
            background: var(--bg-primary);
            border-radius: 56px;
            box-shadow: 0 0 0 14px #12100E, 0 25px 100px rgba(0,0,0,0.5);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            transform: scale(0.92);
        }

        .screen {
            display: none;
            flex-direction: column;
            height: 100%;
            background: var(--bg-primary);
            opacity: 0;
            transform: translateX(20px);
            transition: opacity 0.3s, transform 0.3s;
        }

        .screen.active {
            display: flex;
            opacity: 1;
            transform: translateX(0);
        }

        .status-bar {
            height: 44px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 24px;
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 600;
            flex-shrink: 0;
            background: rgba(26,22,20,0.9);
            backdrop-filter: blur(20px);
        }

        .app-bar {
            padding: 16px 24px;
            background: var(--bg-primary);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .app-bar-title {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-primary);
            flex: 1;
        }

        .icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 18px;
        }

        .icon-btn:hover {
            color: var(--tan);
            border-color: var(--tan);
        }

        .screen-content {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: none;
        }

        .screen-content::-webkit-scrollbar { display: none; }

        /* Profile Screen */
        .profile-header {
            padding: 32px 24px 24px;
            text-align: center;
            background: linear-gradient(180deg, var(--bg-secondary) 0%, transparent 100%);
        }

        .profile-avatar {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--surface-alt), var(--surface));
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            border: 3px solid var(--tan);
            position: relative;
        }

        .profile-avatar .online-dot {
            position: absolute;
            bottom: 5px;
            right: 5px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--success);
            border: 3px solid var(--bg-primary);
        }

        .profile-name {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .profile-level {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--tan);
            color: var(--bg-primary);
            font-size: 12px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: var(--radius-full);
            margin-bottom: 12px;
        }

        .profile-stats {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 16px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 24px;
            font-weight: 800;
            color: var(--tan);
        }

        .stat-label {
            font-size: 11px;
            color: var(--text-subtle);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .xp-section {
            margin: 0 24px 24px;
            padding: 16px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
        }

        .xp-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .xp-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .xp-current {
            font-size: 12px;
            font-weight: 700;
            color: var(--tan);
        }

        .xp-bar {
            height: 8px;
            background: var(--surface-alt);
            border-radius: var(--radius-full);
            overflow: hidden;
        }

        .xp-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--tan), var(--tan));
            border-radius: var(--radius-full);
            width: 75%;
        }

        .xp-hint {
            font-size: 10px;
            color: var(--text-subtle);
            margin-top: 8px;
            text-align: center;
        }

        /* Settings Sections */
        .settings-section {
            margin: 0 24px 24px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .settings-item {
            display: flex;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: background 0.2s;
        }

        .settings-item:hover {
            background: var(--surface-alt);
        }

        .settings-item:last-child {
            border-bottom: none;
        }

        .settings-icon {
            width: 40px;
            height: 40px;
            background: var(--surface-alt);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tan);
            font-size: 18px;
            margin-right: 14px;
        }

        .settings-info {
            flex: 1;
        }

        .settings-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 2px;
        }

        .settings-desc {
            font-size: 11px;
            color: var(--text-subtle);
        }

        .settings-arrow {
            color: var(--text-subtle);
            font-size: 16px;
        }

        /* Toggle Switch */
        .toggle-switch {
            width: 50px;
            height: 28px;
            background: var(--surface-alt);
            border-radius: var(--radius-full);
            position: relative;
            cursor: pointer;
            transition: background 0.2s;
        }

        .toggle-switch.active {
            background: var(--tan);
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 22px;
            height: 22px;
            background: white;
            border-radius: 50%;
            transition: transform 0.2s;
        }

        .toggle-switch.active::after {
            transform: translateX(22px);
        }

        /* FAQ Section */
        .faq-item {
            border-bottom: 1px solid var(--border);
        }

        .faq-question {
            padding: 18px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .faq-question:hover {
            background: var(--surface-alt);
        }

        .faq-answer {
            padding: 0 16px 18px;
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.5;
            display: none;
        }

        .faq-answer.show {
            display: block;
        }

        .faq-icon {
            color: var(--tan);
            transition: transform 0.2s;
        }

        .faq-icon.rotated {
            transform: rotate(180deg);
        }

        /* Update History */
        .update-item {
            padding: 16px;
            border-bottom: 1px solid var(--border);
        }

        .update-item:last-child {
            border-bottom: none;
        }

        .update-version {
            font-size: 14px;
            font-weight: 700;
            color: var(--tan);
            margin-bottom: 6px;
        }

        .update-date {
            font-size: 11px;
            color: var(--text-subtle);
            margin-bottom: 10px;
        }

        .update-changes {
            list-style: none;
        }

        .update-changes li {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 6px;
            padding-left: 16px;
            position: relative;
        }

        .update-changes li::before {
            content: '•';
            position: absolute;
            left: 0;
            color: var(--tan);
        }

        /* Badge */
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: var(--radius-full);
            font-size: 10px;
            font-weight: 700;
        }

        .badge-new {
            background: var(--success-bg);
            color: var(--success);
        }

        .badge-hot {
            background: rgba(181, 139, 122, 0.15);
            color: var(--warning);
        }

        /* Bottom Nav */
        .bottom-nav {
            height: 72px;
            background: rgba(42, 37, 34, 0.97);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-shrink: 0;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: var(--text-subtle);
            cursor: pointer;
            padding: 8px 16px;
        }

        .nav-item.active {
            color: var(--tan);
        }

        .nav-icon {
            font-size: 20px;
        }

        .nav-label {
            font-size: 10px;
            font-weight: 600;
        }

        /* Buttons */
        .btn {
            width: 100%;
            height: 52px;
            border-radius: var(--radius-lg);
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            border: none;
        }

        .btn-primary {
            background: var(--tan);
            color: var(--bg-primary);
        }

        .btn-primary:hover {
            opacity: 0.92;
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-primary);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            border-color: var(--tan);
        }

        .btn-danger {
            background: rgba(166, 123, 123, 0.15);
            color: var(--danger);
            border: 1px solid rgba(166, 123, 123, 0.3);
        }

        /* Admin Panel */
        .admin-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin: 0 24px 24px;
        }

        .admin-stat-card {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 16px;
            text-align: center;
        }

        .admin-stat-value {
            font-size: 28px;
            font-weight: 800;
            color: var(--tan);
            margin-bottom: 4px;
        }

        .admin-stat-label {
            font-size: 11px;
            color: var(--text-subtle);
            font-weight: 600;
        }

        /* Toast */
        .toast {
            position: fixed;
            top: 60px;
            left: 50%;
            transform: translateX(-50%) translateY(-20px);
            background: var(--surface-alt);
            border: 1px solid var(--border);
            padding: 13px 22px;
            border-radius: var(--radius-full);
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 9px;
            backdrop-filter: blur(20px);
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .toast i {
            color: var(--tan);
            font-size: 16px;
        }

        /* Navigation Helpers */
        .nav-helpers {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            z-index: 1000;
            max-width: 600px;
            justify-content: center;
        }

        .nav-helper-btn {
            background: rgba(26, 26, 23, 0.95);
            border: 2px solid var(--tan);
            border-radius: var(--radius-lg);
            padding: 8px 14px;
            color: var(--tan);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .nav-helper-btn:hover {
            background: var(--tan);
            color: var(--bg-primary);
        }

        /* Search Input */
        .search-input-wrapper {
            margin: 0 24px 16px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .search-input {
            flex: 1;
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 15px;
            outline: none;
        }

        /* Live Feed Item */
        .live-feed-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 14px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
        }

        .live-feed-item:hover {
            background: var(--surface-alt);
        }

        .product-image {
            width: 50px;
            height: 50px;
            background: var(--surface-alt);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: var(--tan);
        }

        .product-info { flex: 1; }

        .product-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .product-meta {
            font-size: 10px;
            color: var(--text-subtle);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .product-price {
            font-size: 16px;
            font-weight: 700;
            color: var(--tan);
        }

        /* Trend Card */
        .trend-scroll {
            display: flex;
            gap: 13px;
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .trend-card {
            flex-shrink: 0;
            width: 155px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            cursor: pointer;
        }

        .trend-card:hover {
            border-color: var(--tan);
        }

        .trend-image {
            height: 105px;
            background: var(--surface-alt);
            border-radius: var(--radius-xl) var(--radius-xl) 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 42px;
            color: var(--tan);
        }

        .trend-content { padding: 11px; }

        .trend-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 3px;
        }

        .trend-price {
            font-size: 10px;
            color: var(--text-subtle);
        }

        /* FAB */
        .fab {
            position: absolute;
            bottom: 90px;
            right: 20px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--tan);
            color: var(--bg-primary);
            border: none;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(196, 165, 123, 0.3);
        }

        /* Cart Screen */
        .summary-card {
            margin: 16px;
            padding: 18px;
            background: linear-gradient(135deg, rgba(196, 165, 123, 0.08), rgba(196, 165, 123, 0.02));
            border-radius: var(--radius-xl);
            border: 1px solid rgba(196, 165, 123, 0.25);
            text-align: center;
        }

        .summary-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-subtle);
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .summary-total {
            font-size: 36px;
            font-weight: 900;
            color: var(--text-primary);
            letter-spacing: -1px;
        }

        .savings-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--success-bg);
            color: var(--success);
            padding: 6px 12px;
            border-radius: var(--radius-full);
            border: 1px solid rgba(138, 154, 139, 0.3);
            margin-top: 12px;
            font-size: 12px;
            font-weight: 700;
        }

        .toggle-container {
            margin: 0 16px 16px;
            padding: 4px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            display: flex;
        }

        .toggle-option {
            flex: 1;
            padding: 10px;
            text-align: center;
            border-radius: var(--radius-md);
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--text-secondary);
        }

        .toggle-option.active {
            background: var(--tan);
            color: var(--bg-primary);
        }

        .cart-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            margin: 0 16px 10px;
            cursor: pointer;
        }

        .cart-item:hover {
            border-color: var(--tan);
        }

        .cart-item-header {
            padding: 14px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .cart-item-platform {
            padding: 10px 14px;
            background: var(--surface-alt);
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .platform-logo {
            width: 24px;
            height: 24px;
            background: var(--tan);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            color: var(--bg-primary);
        }

        .trust-badge {
            padding: 3px 6px;
            background: var(--success-bg);
            border-radius: var(--radius-sm);
            border: 1px solid rgba(138, 154, 139, 0.3);
            font-size: 10px;
            font-weight: 700;
            color: var(--success);
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .action-bar {
            padding: 12px 16px 18px;
            background: linear-gradient(180deg, transparent, rgba(26, 22, 20, 0.95));
        }

        .action-bar .btn {
            margin-bottom: 10px;
        }

        .microcopy {
            text-align: center;
            font-size: 10px;
            color: var(--text-subtle);
            margin-top: 10px;
            line-height: 1.45;
        }

        /* Product Detail Specific */
        .detail-hero {
            padding: 24px;
            text-align: center;
        }

        .detail-image {
            width: 160px;
            height: 160px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 72px;
            color: var(--tan);
            border: 1px solid var(--border);
        }

        .detail-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

        .detail-meta {
            font-size: 13px;
            color: var(--text-subtle);
            margin-bottom: 10px;
        }

        .detail-rating {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--surface);
            padding: 5px 11px;
            border-radius: var(--radius-full);
            border: 1px solid var(--border);
            font-size: 12px;
            color: var(--text-secondary);
        }

        .best-price-card {
            margin: 0 24px 16px;
            background: linear-gradient(135deg, var(--surface-alt), var(--surface));
            border: 1px solid rgba(196, 165, 123, 0.25);
            border-radius: var(--radius-xl);
            padding: 22px;
            position: relative;
        }

        .best-price-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--tan), var(--tan));
        }

        .trust-block {
            margin: 0 24px 20px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 18px;
            border: 1px solid var(--border);
        }

        .trust-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-top: 14px;
        }

        .trust-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .trust-icon {
            width: 28px;
            height: 28px;
            background: var(--surface-alt);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tan);
            font-size: 12px;
            border: 1px solid var(--border);
        }

        .contributor-spotlight {
            margin: 0 24px 20px;
            background: var(--surface-alt);
            border-radius: var(--radius-lg);
            padding: 14px 18px;
