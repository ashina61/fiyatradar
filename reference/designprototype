<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FiyatRadar V11 — Full App</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #1A1614;
            --bg-secondary: #24201D;
            --surface: #2A2522;
            --surface-alt: #312C29;
            --surface-elevated: #3D3633;
            --border: rgba(61, 54, 51, 0.4);
            --border-light: rgba(245, 241, 237, 0.06);
            --text-primary: rgba(250, 246, 242, 0.96);
            --text-secondary: rgba(210, 200, 190, 0.68);
            --text-subtle: rgba(201, 191, 184, 0.42);
            --tan: #C4A57B;
            --tan-light: #D4B896;
            --tan-dark: #9A8260;
            --success: #8A9A8B;
            --success-bg: rgba(138, 154, 139, 0.12);
            --danger: #A67B7B;
            --danger-bg: rgba(166, 123, 123, 0.12);
            --warning: #B58B7A;
            --warning-bg: rgba(181, 139, 122, 0.12);
            --purple: #8A7BA6;
            --purple-bg: rgba(138, 123, 166, 0.12);
            --radius-sm: 8px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --radius-xl: 18px;
            --radius-2xl: 22px;
            --radius-full: 9999px;
            --shadow-md: 0 2px 6px rgba(0,0,0,0.18);
            --shadow-lg: 0 4px 12px rgba(0,0,0,0.22);
            --shadow-glow: 0 0 20px rgba(196, 165, 123, 0.12);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #E8E4DF 0%, #D4CFC7 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .phone-frame {
            width: 390px;
            height: 844px;
            background: var(--bg-primary);
            border-radius: 56px;
            box-shadow: 0 0 0 14px #12100E, 0 25px 100px rgba(0,0,0,0.5), 0 0 60px rgba(196, 165, 123, 0.08);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .screen {
            display: none;
            flex-direction: column;
            height: 100%;
            background: var(--bg-primary);
            opacity: 0;
            transform: translateX(20px);
            transition: opacity 0.3s, transform 0.3s;
        }

        .screen.active {
            display: flex;
            opacity: 1;
            transform: translateX(0);
        }

        .status-bar {
            height: 44px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 24px;
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 600;
            flex-shrink: 0;
            background: linear-gradient(180deg, rgba(26,22,20,0.88) 0%, transparent 100%);
            backdrop-filter: blur(20px);
        }

        /* Top Bar */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
            background: linear-gradient(180deg, var(--bg-primary) 0%, transparent 100%);
            flex-shrink: 0;
        }

        .top-bar-left {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--tan), var(--tan-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 800;
            color: var(--bg-primary);
            border: 2px solid rgba(196, 165, 123, 0.3);
            transition: all 0.2s;
        }

        .user-avatar:hover { transform: scale(1.05); box-shadow: var(--shadow-glow); }

        .user-info { display: flex; flex-direction: column; }
        .user-greeting { font-size: 10px; font-weight: 500; color: var(--text-subtle); }
        .user-name { font-size: 14px; font-weight: 700; color: var(--text-primary); }

        .top-bar-right { display: flex; align-items: center; gap: 8px; }

        .notification-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 18px;
            position: relative;
            transition: all 0.2s;
        }

        .notification-btn:hover { color: var(--tan); border-color: rgba(196, 165, 123, 0.25); }

        .notification-badge {
            position: absolute;
            top: -2px; right: -2px;
            width: 18px; height: 18px;
            border-radius: 50%;
            background: var(--danger);
            color: white;
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--bg-primary);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Search */
        .search-input-wrapper {
            margin: 0 24px 16px;
            background: rgba(42, 37, 34, 0.6);
            backdrop-filter: blur(20px);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow-md);
        }

        .search-input { flex: 1; background: none; border: none; color: var(--text-primary); font-size: 15px; outline: none; font-weight: 500; }
        .search-input::placeholder { color: var(--text-subtle); font-weight: 400; }

        .scan-btn {
            width: 36px; height: 36px;
            border-radius: var(--radius-md);
            background: var(--surface-secondary);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* Categories */
        .categories-section { padding: 0 24px 16px; }

        .categories-scroll {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            scrollbar-width: none;
            padding-bottom: 4px;
        }

        .categories-scroll::-webkit-scrollbar { display: none; }

        .category-chip {
            flex-shrink: 0;
            padding: 8px 16px;
            border-radius: var(--radius-full);
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .category-chip:hover, .category-chip.active {
            background: var(--tan);
            color: var(--bg-primary);
            border-color: var(--tan);
        }

        .category-chip i { font-size: 14px; }

        /* Flash Deal */
        .flash-deal-banner {
            margin: 0 24px 16px;
            padding: 16px;
            background: linear-gradient(135deg, #8B2500, #B84A1A);
            border-radius: var(--radius-xl);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
        }

        .flash-deal-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
        }

        .flash-deal-banner:hover { transform: scale(0.98); }

        .flash-deal-content { position: relative; z-index: 1; }

        .flash-deal-tag {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            background: rgba(255,255,255,0.2);
            border-radius: var(--radius-full);
            font-size: 9px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .flash-deal-title { font-size: 15px; font-weight: 800; color: white; margin-bottom: 4px; }

        .flash-deal-timer { display: flex; gap: 6px; position: relative; z-index: 1; }

        .timer-block {
            text-align: center;
            background: rgba(0,0,0,0.3);
            border-radius: var(--radius-sm);
            padding: 6px 8px;
            min-width: 40px;
        }

        .timer-value { font-size: 18px; font-weight: 800; color: white; line-height: 1; }
        .timer-label { font-size: 8px; color: rgba(255,255,255,0.6); text-transform: uppercase; margin-top: 2px; }

        /* Banner Carousel */
        .banner-section { padding: 0 24px 16px; }

        .banner-carousel {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding-bottom: 8px;
        }

        .banner-carousel::-webkit-scrollbar { display: none; }

        .banner-card {
            flex-shrink: 0;
            width: 100%;
            height: 130px;
            border-radius: var(--radius-xl);
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            cursor: pointer;
            scroll-snap-align: start;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s;
        }

        .banner-card:hover { transform: scale(0.98); }

        .banner-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
        }

        .banner-content { position: relative; z-index: 1; }

        .banner-tag {
            display: inline-block;
            padding: 4px 10px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(8px);
            border-radius: var(--radius-full);
            font-size: 10px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .banner-title { font-size: 18px; font-weight: 800; color: white; margin-bottom: 4px; }
        .banner-desc { font-size: 12px; color: rgba(255,255,255,0.8); }

        .banner-dots { display: flex; justify-content: center; gap: 6px; margin-top: 12px; }

        .banner-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--surface-elevated);
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.2s;
        }

        .banner-dot.active {
            background: var(--tan);
            border-color: var(--tan);
            width: 18px;
            border-radius: 3px;
        }

        /* Section Headers */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 24px;
            margin-bottom: 12px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .section-title i { color: var(--tan); }

        .section-link {
            font-size: 12px;
            color: var(--tan);
            font-weight: 600;
            cursor: pointer;
        }

        /* Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            padding: 0 24px 24px;
        }

        .product-card {
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            overflow: hidden;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-3px);
            border-color: rgba(196, 165, 123, 0.25);
            box-shadow: var(--shadow-lg), var(--shadow-glow);
        }

        .product-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--tan), var(--tan-light));
            opacity: 0;
            transition: opacity 0.2s;
        }

        .product-card:hover::before { opacity: 1; }

        .card-image {
            height: 100px;
            background: linear-gradient(135deg, var(--surface-alt), var(--surface-elevated));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            position: relative;
        }

        .card-favorite {
            position: absolute;
            top: 8px; right: 8px;
            width: 28px; height: 28px;
            border-radius: 50%;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            color: rgba(255,255,255,0.6);
            font-size: 14px;
        }

        .card-favorite:hover, .card-favorite.active { color: var(--danger); background: rgba(0,0,0,0.7); }

        .card-change-badge {
            position: absolute;
            top: 8px; left: 8px;
            padding: 3px 7px;
            border-radius: var(--radius-sm);
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .card-change-badge.down { background: var(--success-bg); color: var(--success); border: 1px solid rgba(138, 154, 139, 0.25); }
        .card-change-badge.up { background: var(--danger-bg); color: var(--danger); border: 1px solid rgba(166, 123, 123, 0.25); }

        .card-content { padding: 11px; }

        .card-name {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.3;
        }

        .card-price {
            font-size: 16px;
            font-weight: 800;
            color: var(--tan);
            margin-bottom: 8px;
        }

        .card-price .currency { font-size: 12px; font-weight: 600; margin-left: 2px; opacity: 0.7; }

        .card-meta { display: flex; flex-direction: column; gap: 4px; }

        .card-meta-row {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 9px;
            color: var(--text-subtle);
        }

        .card-meta-row i { font-size: 8px; }
        .card-meta-row .user { color: var(--tan); font-weight: 600; }

        /* Smart Suggestions */
        .suggestions-section { padding: 0 24px 24px; }

        .suggestion-card {
            background: linear-gradient(135deg, var(--surface), var(--surface-alt));
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            padding: 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .suggestion-card:hover { border-color: rgba(196, 165, 123, 0.25); transform: translateX(4px); }

        .suggestion-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .suggestion-info { flex: 1; }
        .suggestion-name { font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
        .suggestion-reason { font-size: 11px; color: var(--text-subtle); }
        .suggestion-price { font-size: 16px; font-weight: 700; color: var(--tan); }

        /* FAB */
        .fab {
            position: absolute;
            bottom: 90px;
            right: 20px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--tan), var(--tan-light));
            color: var(--bg-primary);
            border: none;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(196, 165, 123, 0.3), 0 0 20px rgba(196, 165, 123, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            z-index: 50;
        }

        .fab:hover { transform: scale(1.05); }

        /* Bottom Nav */
        .bottom-nav {
            height: 72px;
            background: linear-gradient(0deg, rgba(26,22,20,0.97) 0%, rgba(26,22,20,0.82) 100%);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-shrink: 0;
            backdrop-filter: blur(20px);
            padding-bottom: 5px;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: var(--text-subtle);
            cursor: pointer;
            padding: 6px 12px;
            border-radius: var(--radius-lg);
            position: relative;
            transition: all 0.2s;
        }

        .nav-item::before {
            content: '';
            position: absolute;
            bottom: 5px;
            width: 3px; height: 3px;
            border-radius: 50%;
            background: var(--tan);
            opacity: 0;
            transition: all 0.2s;
        }

        .nav-item.active { color: var(--tan); background: rgba(196, 165, 123, 0.06); }
        .nav-item.active::before { opacity: 1; }

        .nav-icon { font-size: 18px; transition: transform 0.2s; }
        .nav-item:hover .nav-icon { transform: scale(1.06); }
        .nav-label { font-size: 9px; font-weight: 600; letter-spacing: 0.2px; }

        /* Admin Panel */
        .admin-screen {
            display: none;
            flex-direction: column;
            height: 100%;
            background: var(--bg-primary);
        }

        .admin-screen.active { display: flex; }

        .admin-header {
            padding: 16px 24px;
            background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-title { font-size: 18px; font-weight: 800; color: var(--text-primary); }

        .admin-close {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .admin-tabs {
            display: flex;
            overflow-x: auto;
            padding: 0 24px;
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border);
            scrollbar-width: none;
        }

        .admin-tabs::-webkit-scrollbar { display: none; }

        .admin-tab {
            padding: 14px 16px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-subtle);
            cursor: pointer;
            white-space: nowrap;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }

        .admin-tab.active { color: var(--tan); border-bottom-color: var(--tan); }

        .admin-content { flex: 1; overflow-y: auto; padding: 24px; }

        .admin-section { display: none; }
        .admin-section.active { display: block; }

        /* Admin Stats Grid */
        .admin-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }

        .admin-stat-card {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 16px;
        }

        .admin-stat-icon {
            width: 36px; height: 36px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .admin-stat-value { font-size: 24px; font-weight: 800; color: var(--text-primary); }
        .admin-stat-label { font-size: 11px; color: var(--text-subtle); margin-top: 4px; }

        .admin-stat-change {
            font-size: 10px;
            font-weight: 600;
            margin-top: 6px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 6px;
            border-radius: var(--radius-sm);
        }

        .admin-stat-change.up { background: var(--success-bg); color: var(--success); }
        .admin-stat-change.down { background: var(--danger-bg); color: var(--danger); }

        /* Admin Table */
        .admin-table {
            width: 100%;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .admin-table-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 60px;
            padding: 12px 16px;
            background: var(--surface-alt);
            font-size: 11px;
            font-weight: 600;
            color: var(--text-subtle);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .admin-table-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 60px;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-light);
            align-items: center;
            transition: background 0.2s;
        }

        .admin-table-row:hover { background: var(--surface-alt); }
        .admin-table-row:last-child { border-bottom: none; }

        .table-product { display: flex; align-items: center; gap: 10px; }

        .table-icon {
            width: 32px; height: 32px;
            border-radius: var(--radius-sm);
            background: var(--surface-elevated);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .table-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
        .table-category { font-size: 12px; color: var(--text-secondary); }
        .table-price { font-size: 14px; font-weight: 700; color: var(--tan); }

        .table-status {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: var(--radius-sm);
            text-align: center;
        }

        .table-status.active { background: var(--success-bg); color: var(--success); }
        .table-status.pending { background: var(--warning-bg); color: var(--warning); }

        .table-actions { display: flex; gap: 6px; }

        .table-action-btn {
            width: 28px; height: 28px;
            border-radius: var(--radius-sm);
            background: var(--surface-elevated);
            border: 1px solid var(--border);
            color: var(--text-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.2s;
        }

        .table-action-btn:hover { color: var(--tan); border-color: rgba(196, 165, 123, 0.25); }

        /* Admin Form */
        .admin-form-group { margin-bottom: 16px; }

        .admin-form-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .admin-form-input {
            width: 100%;
            padding: 12px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            color: var(--text-primary);
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        .admin-form-input:focus { border-color: var(--tan); }
        .admin-form-input::placeholder { color: var(--text-subtle); }

        .admin-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

        .admin-btn {
            width: 100%;
            height: 48px;
            border-radius: var(--radius-md);
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            transition: all 0.2s;
        }

        .admin-btn-primary {
            background: linear-gradient(135deg, var(--tan), var(--tan-light));
            color: var(--bg-primary);
        }

        .admin-btn-primary:hover { opacity: 0.92; }

        .admin-btn-secondary {
            background: var(--surface);
            color: var(--text-primary);
            border: 1px solid var(--border);
        }

        /* Banner Admin */
        .banner-admin-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            gap: 14px;
            align-items: center;
        }

        .banner-admin-preview {
            width: 80px;
            height: 50px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            color: white;
            flex-shrink: 0;
        }

        .banner-admin-info { flex: 1; }
        .banner-admin-title { font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
        .banner-admin-desc { font-size: 11px; color: var(--text-subtle); }
        .banner-admin-actions { display: flex; gap: 6px; }

        /* Toggle */
        .toggle-switch {
            width: 48px; height: 26px;
            background: var(--surface-alt);
            border-radius: var(--radius-full);
            position: relative;
            cursor: pointer;
            transition: background 0.2s;
            border: 1px solid var(--border);
        }

        .toggle-switch.active { background: var(--tan); border-color: var(--tan); }

        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 2px; left: 2px;
            width: 20px; height: 20px;
            background: white;
            border-radius: 50%;
            transition: transform 0.2s;
            box-shadow: var(--shadow-sm);
        }

        .toggle-switch.active::after { transform: translateX(22px); }

        /* Notification Panel */
        .notification-panel {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: var(--bg-primary);
            z-index: 200;
            display: none;
            flex-direction: column;
            opacity: 0;
            transform: translateY(-20px);
            transition: opacity 0.3s, transform 0.3s;
        }

        .notification-panel.active { display: flex; opacity: 1; transform: translateY(0); }

        .notif-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
        }

        .notif-title { font-size: 18px; font-weight: 800; color: var(--text-primary); }

        .notif-close {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .notif-list { flex: 1; overflow-y: auto; padding: 16px 24px; }

        .notif-item {
            display: flex;
            gap: 12px;
            padding: 14px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .notif-item:hover { border-color: rgba(196, 165, 123, 0.25); }
        .notif-item.unread { border-left: 3px solid var(--tan); }

        .notif-icon {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: var(--surface-alt);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .notif-content { flex: 1; }
        .notif-text { font-size: 13px; color: var(--text-primary); margin-bottom: 4px; }
        .notif-time { font-size: 10px; color: var(--text-subtle); }

        /* Screen Content */
        .screen-content { flex: 1; overflow-y: auto; scrollbar-width: none; }
        .screen-content::-webkit-scrollbar { display: none; }

        /* Toast */
        .toast {
            position: fixed;
            top: 60px;
            left: 50%;
            transform: translateX(-50%) translateY(-20px);
            background: var(--surface-alt);
            border: 1px solid var(--border);
            padding: 13px 22px;
            border-radius: var(--radius-full);
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 600;
            box-shadow: var(--shadow-lg);
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 9px;
            backdrop-filter: blur(20px);
        }

        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .toast i { color: var(--tan); font-size: 16px; }

        /* Live Feed Item */
        .live-feed-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 14px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .live-feed-item:hover { background: var(--surface-alt); border-color: rgba(196, 165, 123, 0.25); }

        .filter-chip {
            padding: 7px 14px;
            background: var(--surface);
            border-radius: var(--radius-full);
            border: 1px solid var(--border);
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .filter-chip.active { background: var(--tan); color: var(--bg-primary); border-color: var(--tan); }
        .filter-chip:hover:not(.active) { border-color: rgba(196, 165, 123, 0.25); }

        /* Price Drop Alert */
        @keyframes slideInAlert {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .price-drop-alert {
            position: absolute;
            top: 100px;
            right: 20px;
            background: linear-gradient(135deg, var(--success), #6B8A6B);
            color: white;
            padding: 12px 16px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            z-index: 100;
            display: none;
            animation: slideInAlert 0.3s ease-out;
            max-width: 260px;
        }

        .price-drop-alert.show { display: block; }

        .alert-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
        .alert-title { font-size: 12px; font-weight: 700; }
        .alert-text { font-size: 11px; opacity: 0.9; }
        .alert-price { font-size: 16px; font-weight: 800; margin-top: 4px; }

        /* App Bar */
        .app-bar {
            padding: 16px 24px;
            background: linear-gradient(180deg, var(--bg-primary) 0%, transparent 100%);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        /* Profile Screen Specific */
        .profile-header {
            padding: 32px 24px 24px;
            text-align: center;
            background: linear-gradient(180deg, var(--bg-secondary) 0%, transparent 100%);
        }

        .profile-avatar-large {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(196, 165, 123, 0.2), rgba(196, 165, 123, 0.05));
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            font-weight: 800;
            color: var(--tan);
            border: 2px solid rgba(196, 165, 123, 0.3);
        }

        .profile-name-large {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .profile-level-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, rgba(196, 165, 123, 0.15), rgba(196, 165, 123, 0.05));
            color: var(--tan);
            font-size: 12px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            border: 1px solid rgba(196, 165, 123, 0.2);
            margin-bottom: 12px;
        }

        .profile-stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin-top: 20px;
        }

        .profile-stat-item {
            text-align: center;
            padding: 14px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
        }

        .profile-stat-value { font-size: 22px; font-weight: 800; color: var(--tan); }
        .profile-stat-label { font-size: 10px; color: var(--text-subtle); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.3px; }

        .xp-section {
            margin: 0 24px 24px;
            padding: 16px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
        }

        .xp-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }

        .xp-bar { height: 8px; background: var(--surface-alt); border-radius: var(--radius-full); overflow: hidden; }

        .xp-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--tan), var(--tan-light));
            border-radius: var(--radius-full);
            width: 75%;
            box-shadow: 0 0 10px rgba(196, 165, 123, 0.3);
        }

        /* Settings Section */
        .settings-section {
            margin: 0 24px 24px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .settings-item {
            display: flex;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid var(--border-light);
            cursor: pointer;
            transition: background 0.2s;
        }

        .settings-item:hover { background: var(--surface-alt); }
        .settings-item:last-child { border-bottom: none; }

        .settings-icon {
            width: 36px; height: 36px;
            border-radius: var(--radius-md);
            background: var(--surface-alt);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tan);
            font-size: 16px;
            margin-right: 12px;
            border: 1px solid var(--border);
        }

        .settings-info { flex: 1; }
        .settings-label { font-size: 14px; font-weight: 600; color: var(--text-primary); }
        .settings-arrow { color: var(--text-subtle); font-size: 16px; }

        .btn-danger {
            width: 100%;
            height: 52px;
            border-radius: var(--radius-lg);
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            transition: all 0.2s;
            background: rgba(166, 123, 123, 0.15);
            color: var(--danger);
            border: 1px solid rgba(166, 123, 123, 0.3);
        }

        .btn-danger:hover { background: rgba(166, 123, 123, 0.25); }

        /* Detail Screen */
        .detail-hero { padding: 24px; text-align: center; }

        .detail-image {
            width: 160px;
            height: 160px;
            background: linear-gradient(135deg, var(--surface), var(--surface-alt));
            border-radius: var(--radius-2xl);
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 72px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-lg);
        }

        .detail-title { font-size: 22px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
        .detail-meta { font-size: 13px; color: var(--text-subtle); margin-bottom: 10px; }

        .detail-rating {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--surface);
            padding: 5px 11px;
            border-radius: var(--radius-full);
            border: 1px solid var(--border);
            font-size: 12px;
            color: var(--text-secondary);
        }

        .best-price-card {
            margin: 0 24px 16px;
            background: linear-gradient(135deg, var(--surface-alt), var(--surface));
            border: 1px solid rgba(196, 165, 123, 0.25);
            border-radius: var(--radius-xl);
            padding: 22px;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }

        .best-price-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--tan), var(--tan-light));
        }

        .trust-block {
            margin: 0 24px 20px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 18px;
            border: 1px solid var(--border);
        }

        .trust-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border-light);
        }

        .trust-score { display: flex; align-items: center; gap: 6px; }
        .score-val { font-size: 18px; font-weight: 700; color: var(--success); }

        .trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

        .trust-item { display: flex; align-items: flex-start; gap: 10px; }

        .trust-icon {
            width: 28px; height: 28px;
            background: var(--surface-alt);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tan);
            font-size: 12px;
            border: 1px solid var(--border);
        }

        .verification-section {
            margin: 0 24px 20px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 18px;
            border: 1px solid var(--border);
        }

        .verification-header { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
        .verification-title { font-size: 13px; font-weight: 600; color: var(--text-primary); }

        .verification-stats { display: flex; gap: 16px; margin-bottom: 14px; }
        .verification-stat { text-align: center; }
        .verification-stat-value { font-size: 20px; font-weight: 700; }
        .verification-stat-value.approved { color: var(--success); }
        .verification-stat-value.rejected { color: var(--danger); }
        .verification-stat-label { font-size: 10px; color: var(--text-subtle); font-weight: 600; }

        .verification-buttons { display: flex; gap: 10px; }

        .verification-btn {
            flex: 1;
            height: 44px;
            border-radius: var(--radius-md);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s;
            border: none;
        }

        .verification-btn.approve {
            background: var(--success-bg);
            color: var(--success);
            border: 1px solid rgba(138, 154, 139, 0.3);
        }

        .verification-btn.approve:hover { background: rgba(138, 154, 139, 0.2); }

        .verification-btn.reject {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1px solid rgba(166, 123, 123, 0.3);
        }

        .verification-btn.reject:hover { background: rgba(166, 123, 123, 0.2); }
        .verification-btn.voted { opacity: 0.5; cursor: not-allowed; }

        .chart-container {
            margin: 0 24px 20px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 18px;
            border: 1px solid var(--border);
        }

        .chart-bars { height: 100px; display: flex; align-items: flex-end; justify-content: space-between; gap: 5px; padding-top: 10px; }

        .chart-bar { flex: 1; background: var(--surface-alt); border-radius: 3px 3px 0 0; transition: height 0.3s; }
        .chart-bar.active { background: linear-gradient(180deg, var(--tan), var(--tan-dark)); box-shadow: 0 0 8px rgba(196, 165, 123, 0.3); }

        .seller-list { margin: 0 24px 20px; }

        .seller-item {
            padding: 12px 0;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .seller-item:hover { transform: translateX(4px); }
        .seller-item:last-child { border-bottom: none; }

        /* Add Price Specific */
        .motivation-banner {
            margin-bottom: 16px;
            padding: 14px;
            background: rgba(138, 154, 139, 0.1);
            border-radius: var(--radius-lg);
            border: 1px solid rgba(138, 154, 139, 0.2);
        }

        .validation-box {
            margin-bottom: 16px;
            padding: 10px 12px;
            background: var(--success-bg);
            border-radius: var(--radius-md);
            border: 1px solid rgba(138, 154, 139, 0.3);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .trust-impact {
            margin-bottom: 24px;
            padding: 14px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
        }

        .trust-impact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }

        .impact-item {
            padding: 12px;
            background: var(--surface-alt);
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            text-align: center;
            font-size: 13px;
            color: var(--text-primary);
            font-weight: 600;
        }

        /* Cart */
        .cart-summary {
            margin: 16px;
            padding: 20px;
            background: linear-gradient(135deg, rgba(196, 165, 123, 0.08), rgba(196, 165, 123, 0.02));
            border-radius: var(--radius-xl);
            border: 1px solid rgba(196, 165, 123, 0.25);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .cart-summary::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--tan), var(--tan-light));
            opacity: 0.6;
        }

        .summary-label { font-size: 11px; font-weight: 600; color: var(--text-subtle); letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 8px; }
        .summary-total { font-size: 36px; font-weight: 900; color: var(--text-primary); letter-spacing: -1px; }

        .savings-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--success-bg);
            color: var(--success);
            padding: 6px 12px;
            border-radius: var(--radius-full);
            border: 1px solid rgba(138, 154, 139, 0.3);
            margin-top: 12px;
            font-size: 12px;
            font-weight: 700;
        }

        .toggle-container {
            margin: 0 24px 16px;
            padding: 4px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            display: flex;
        }

        .toggle-option {
            flex: 1;
            padding: 10px;
            text-align: center;
            border-radius: var(--radius-md);
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .toggle-option.active { background: var(--tan); color: var(--bg-primary); box-shadow: var(--shadow-md); }
        .toggle-option:hover:not(.active) { background: var(--surface-alt); }

        .comparison-section { margin: 0 24px 24px; }
        .comparison-title { font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .comparison-title i { color: var(--tan); }

        .product-comparison {
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            overflow: hidden;
            margin-bottom: 16px;
        }

        .comparison-header {
            padding: 14px 16px;
            background: var(--surface-alt);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .comparison-product-icon {
            width: 40px; height: 40px;
            background: var(--surface-elevated);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .comparison-product-info { flex: 1; }
        .comparison-product-name { font-size: 14px; font-weight: 600; color: var(--text-primary); }
        .comparison-product-qty { font-size: 10px; color: var(--text-subtle); }

        .comparison-rows { padding: 0; }

        .comparison-row {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-light);
            transition: background 0.2s;
        }

        .comparison-row:last-child { border-bottom: none; }
        .comparison-row:hover { background: var(--surface-alt); }
        .comparison-row.best { background: rgba(138, 154, 139, 0.06); border-left: 3px solid var(--success); }

        .comparison-platform {
            width: 28px; height: 28px;
            background: var(--surface-elevated);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            color: var(--tan);
            border: 1px solid var(--border);
        }

        .comparison-platform-name { flex: 1; margin-left: 10px; font-size: 13px; color: var(--text-secondary); }
        .comparison-price { font-size: 15px; font-weight: 700; color: var(--text-primary); }
        .comparison-row.best .comparison-price { color: var(--success); }

        .best-badge {
            margin-left: 8px;
            padding: 2px 6px;
            background: var(--success-bg);
            color: var(--success);
            font-size: 9px;
            font-weight: 700;
            border-radius: var(--radius-sm);
            text-transform: uppercase;
        }

        .diff-badge { margin-left: 6px; font-size: 10px; font-weight: 600; }
