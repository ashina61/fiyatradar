<script>
    function showScreen(screenId) {
        // Hide all screens
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        
        // Show target screen
        document.getElementById(screenId).classList.add('active');
        
        // Update bottom nav
        const navMap = {
            'home-screen': 0,
            'search-screen': 1,
            'add-price-screen': 2,
            'profile-screen': 3,
            'cart-screen': 3
        };
        
        document.querySelectorAll('.bottom-nav').forEach(nav => {
            nav.querySelectorAll('.nav-item').forEach((item, i) => {
                item.classList.toggle('active', navMap[screenId] === i);
            });
        });
        
        // Scroll to top
        const screen = document.getElementById(screenId);
        const content = screen.querySelector('.screen-content');
        if (content) content.scrollTop = 0;
    }

    function toggleSwitch(element) {
        element.classList.toggle('active');
        showToast(element.classList.contains('active') ? 'Açık' : 'Kapalı');
    }

    function toggleFaq(element) {
        const answer = element.nextElementSibling;
        const icon = element.querySelector('.faq-icon');
        answer.classList.toggle('show');
        icon.classList.toggle('rotated');
    }

    function toggleCombination(element) {
        document.querySelectorAll('.toggle-option').forEach(opt => opt.classList.remove('active'));
        element.classList.add('active');
        showToast(element.textContent.trim() + ' seçildi');
    }

    function showToast(msg) {
        const toast = document.getElementById('toast');
        document.getElementById('toast-msg').innerText = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }
</script>

