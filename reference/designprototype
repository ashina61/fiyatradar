<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1"/>
<meta name="theme-color" content="#1A110A"/>
<title>FiyatRadar — Executive</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;0,9..144,900;1,9..144,500&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
/* =========================================================
   FIYATRADAR v3 — EXECUTIVE DESIGN SYSTEM
   ========================================================= */
:root{
  /* Primary surfaces */
  --bg: #EDEAE3;
  --bg-soft: #F3F0E9;
  --bg-deep: #E4DFD6;
  --surface: #FFFFFF;
  --surface-2: #FAF7F1;

  /* Espresso dark hero */
  --espresso: #1A110A;
  --espresso-2: #231710;
  --espresso-3: #2E2016;

  /* Amber gold accent */
  --gold: #C9A063;
  --gold-soft: #D8B783;
  --gold-deep: #A57E46;
  --gold-wash: rgba(201,160,99,.12);

  /* Text */
  --ink: #1A110A;
  --ink-2: #463527;
  --ink-3: #7A6A5A;
  --ink-4: #A79884;
  --ink-on-dark: #F4EDE0;
  --ink-on-dark-2: #C9BCA6;
  --ink-on-dark-3: #7A6A56;

  /* Semantic */
  --positive: #3E7D4F;
  --positive-soft: #E4F0DE;
  --negative: #B4422F;
  --negative-soft: #F5E1DC;
  --neutral: #6B5F50;

  /* Elevation */
  --shadow-sm: 0 1px 2px rgba(26,17,10,.04), 0 2px 6px rgba(26,17,10,.04);
  --shadow-md: 0 4px 14px rgba(26,17,10,.06), 0 10px 30px rgba(26,17,10,.06);
  --shadow-lg: 0 10px 30px rgba(26,17,10,.08), 0 30px 60px rgba(26,17,10,.10);
  --shadow-gold: 0 10px 30px rgba(201,160,99,.25), 0 0 0 1px rgba(201,160,99,.15);

  /* Radii */
  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 22px;
  --r-xl: 28px;
  --r-2xl: 34px;
  --r-pill: 999px;

  /* Layout */
  --frame: 430px;
  --nav-h: 86px;
  --pad: 20px;
}

*,*::before,*::after{box-sizing:border-box;}
html,body{margin:0;padding:0;background:#0d0906;color:var(--ink);font-family:'Manrope',-apple-system,BlinkMacSystemFont,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}
body{
  min-height:100vh;
  display:flex;align-items:flex-start;justify-content:center;
  padding:28px 12px;
  background:
    radial-gradient(1200px 600px at 20% -10%, #2a1d11 0%, transparent 60%),
    radial-gradient(900px 500px at 80% 110%, #1a0f07 0%, transparent 60%),
    #080604;
}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0;}
a{color:inherit;text-decoration:none;}
img{display:block;max-width:100%;}
input,textarea,select{font:inherit;color:inherit;}

/* ---------- Device frame ---------- */
.device{
  position:relative;
  width:100%;max-width:var(--frame);
  min-height:900px;
  background:var(--bg);
  border-radius:44px;
  overflow:hidden;
  box-shadow:
    0 0 0 10px #0b0805,
    0 0 0 11px #2a1d11,
    0 40px 120px rgba(0,0,0,.6),
    0 10px 40px rgba(0,0,0,.5);
  isolation:isolate;
}
.device::before{
  content:"";position:absolute;top:0;left:0;right:0;height:18px;
  background:linear-gradient(180deg,rgba(26,17,10,.04),transparent);
  z-index:1;pointer-events:none;
}

/* ---------- Pages ---------- */
.pages{position:relative;width:100%;min-height:900px;}
.page{display:none;min-height:900px;padding-top:22px;padding-bottom:calc(var(--nav-h) + 40px);}
.page.active{display:block;}
.page.dark-page{background:var(--espresso);color:var(--ink-on-dark);}

/* ---------- Typography primitives ---------- */
.display{font-family:'Fraunces',serif;font-weight:700;letter-spacing:-.02em;line-height:1.02;font-optical-sizing:auto;}
.h1{font-family:'Fraunces',serif;font-weight:700;font-size:44px;line-height:1;letter-spacing:-.03em;}
.h2{font-family:'Fraunces',serif;font-weight:700;font-size:30px;line-height:1.05;letter-spacing:-.02em;}
.h3{font-family:'Fraunces',serif;font-weight:600;font-size:22px;line-height:1.15;letter-spacing:-.01em;}
.h4{font-family:'Manrope';font-weight:700;font-size:16px;letter-spacing:-.005em;}
.overline{font-family:'Manrope';font-weight:700;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-3);}
.overline.gold{color:var(--gold-deep);}
.overline.on-dark{color:var(--gold);}
.body{font-family:'Manrope';font-size:14px;line-height:1.55;color:var(--ink-2);}
.caption{font-family:'Manrope';font-size:12px;color:var(--ink-3);line-height:1.45;}
.numeric{font-family:'Fraunces',serif;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.02em;}

/* ---------- Signature diamond chevron ---------- */
.diamond{
  width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;
  transform:rotate(45deg);background:var(--bg-deep);border-radius:4px;flex-shrink:0;
}
.diamond i{transform:rotate(-45deg);font-size:8px;color:var(--ink-3);}
.diamond.gold{background:var(--gold);box-shadow:0 2px 6px rgba(201,160,99,.35);}
.diamond.gold i{color:var(--espresso);}
.diamond.on-dark{background:rgba(201,160,99,.18);}
.diamond.on-dark i{color:var(--gold);}

/* ---------- Gold pill button (signature) ---------- */
.pill-exec{
  display:flex;align-items:center;gap:14px;
  padding:18px 20px;
  border-radius:var(--r-pill);
  background:linear-gradient(135deg,#2a1d11 0%,#1a110a 100%);
  box-shadow:
    inset 0 1px 0 rgba(201,160,99,.18),
    inset 0 0 0 1px rgba(201,160,99,.12),
    0 10px 30px rgba(26,17,10,.18);
  color:var(--gold);
  position:relative;overflow:hidden;
  transition:transform .15s ease;
  width:100%;
}
.pill-exec::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(400px 60px at 80% 50%, rgba(201,160,99,.18), transparent 70%);
  pointer-events:none;
}
.pill-exec:active{transform:scale(.985);}
.pill-exec .ico{width:36px;height:36px;border-radius:10px;background:rgba(201,160,99,.12);display:flex;align-items:center;justify-content:center;color:var(--gold);flex-shrink:0;}
.pill-exec .label{flex:1;font-family:'Manrope';font-weight:700;font-size:15.5px;letter-spacing:-.005em;}
.pill-exec .chev{width:18px;height:18px;transform:rotate(45deg);background:rgba(201,160,99,.22);border-radius:4px;}

/* ---------- Cards ---------- */
.card{background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);}
.card.plain{background:var(--surface);}
.card-dark{background:var(--espresso);color:var(--ink-on-dark);border-radius:var(--r-xl);position:relative;overflow:hidden;}
.card-dark::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(600px 200px at 100% 0%, rgba(201,160,99,.14), transparent 60%);
  pointer-events:none;
}

/* ============================================================
   HOME PAGE
   ============================================================ */
#home{background:var(--bg);}
.home-greet{
  margin:6px 20px 0;
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:4px 2px;
}
.hg-left{display:flex;align-items:center;gap:14px;cursor:pointer;flex:1;min-width:0;}
.hg-avatar{
  width:52px;height:52px;border-radius:16px;
  background:linear-gradient(145deg,#1a110a 0%,#2a1d11 100%);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 0 2px rgba(201,160,99,.35),0 8px 22px rgba(26,17,10,.18);
  flex-shrink:0;
}
.hg-avatar .ha-logo{font-family:'Fraunces',serif;font-weight:800;font-size:20px;color:var(--gold);letter-spacing:-.04em;line-height:1;display:flex;align-items:center;}
.hg-avatar .ha-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);margin-left:2px;display:inline-block;}
.hg-txt{min-width:0;}
.hg-over{font-family:'Manrope';font-weight:700;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-deep);margin-bottom:3px;}
.hg-name{font-family:'Fraunces',serif;font-weight:600;font-size:22px;letter-spacing:-.02em;line-height:1.1;color:var(--ink);}
.hg-name em{font-style:italic;font-weight:400;color:var(--ink-3);}
.hg-bell{
  width:46px;height:46px;border-radius:14px;
  background:var(--surface);
  border:1px solid var(--bg-deep);
  display:flex;align-items:center;justify-content:center;
  color:var(--ink-2);position:relative;
  box-shadow:var(--shadow-sm);
  flex-shrink:0;
}
.hg-bell .dot{position:absolute;top:10px;right:10px;width:9px;height:9px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 2.5px var(--surface);}

/* Location strip */
.loc-strip{margin:16px 20px 0;padding:14px 18px;background:var(--surface);border-radius:var(--r-lg);display:flex;align-items:center;gap:12px;box-shadow:var(--shadow-sm);}
.loc-strip .loc-ico{width:38px;height:38px;border-radius:12px;background:var(--gold-wash);display:flex;align-items:center;justify-content:center;color:var(--gold-deep);font-size:15px;}
.loc-strip .loc-txt{flex:1;min-width:0;}
.loc-strip .loc-txt .ov{font-family:'Manrope';font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);font-weight:700;margin-bottom:2px;}
.loc-strip .loc-txt .nm{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.loc-strip .loc-txt .nm em{font-style:normal;color:var(--ink-3);font-weight:500;}
.loc-strip .loc-change{padding:8px 14px;border-radius:var(--r-pill);background:var(--espresso);color:var(--gold);font-family:'Manrope';font-weight:700;font-size:12px;letter-spacing:.02em;}

/* Banner */
.home-banner{margin:22px 20px 0;border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--shadow-md);position:relative;height:168px;display:flex;}
.banner-slide{flex-shrink:0;width:100%;display:flex;position:relative;overflow:hidden;}
.banner-slide.b1{background:linear-gradient(115deg,#2a1d11 0%,#1a110a 100%);color:var(--ink-on-dark);}
.banner-slide.b2{background:linear-gradient(115deg,#3E7D4F 0%,#2e5c3a 100%);color:#f0f7ea;}
.banner-slide.b3{background:linear-gradient(115deg,#BF9470 0%,#8d6640 100%);color:#fff;}
.banner-inner{padding:22px 24px;flex:1;display:flex;flex-direction:column;justify-content:space-between;position:relative;z-index:2;}
.banner-slide .b-over{font-family:'Manrope';font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;opacity:.75;}
.banner-slide.b1 .b-over{color:var(--gold);}
.banner-slide .b-head{font-family:'Fraunces',serif;font-weight:700;font-size:22px;line-height:1.1;letter-spacing:-.02em;margin:8px 0 0;max-width:75%;}
.banner-slide .b-sub{font-family:'Manrope';font-size:12px;margin-top:6px;opacity:.8;}
.banner-slide .b-cta{align-self:flex-start;margin-top:12px;padding:9px 14px;border-radius:var(--r-pill);background:rgba(255,255,255,.92);color:var(--espresso);font-family:'Manrope';font-weight:700;font-size:12px;display:inline-flex;align-items:center;gap:7px;}
.banner-slide.b1 .b-cta{background:var(--gold);color:var(--espresso);}
.banner-deco{position:absolute;right:-30px;top:-20px;opacity:.18;font-size:180px;line-height:1;color:currentColor;font-family:'Fraunces',serif;font-weight:700;}
.banner-dots{position:absolute;bottom:12px;right:18px;display:flex;gap:6px;z-index:3;}
.banner-dots i{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.35);transition:all .25s;}
.banner-dots i.on{width:18px;background:#fff;border-radius:3px;}

/* Section heads */
.sec{margin:28px 20px 0;}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:14px;}
.sec-head h3{font-family:'Fraunces',serif;font-weight:700;font-size:22px;letter-spacing:-.02em;color:var(--ink);margin:0;}
.sec-head h3 em{font-style:italic;font-weight:400;color:var(--ink-3);}
.sec-head .sh-over{display:block;font-family:'Manrope';font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-deep);font-weight:700;margin-bottom:4px;}
.sec-head .see{font-family:'Manrope';font-weight:700;font-size:12px;color:var(--gold-deep);display:flex;align-items:center;gap:6px;padding-bottom:4px;}
.sec-head .see i{font-size:9px;}

/* Category rail */
.cat-rail{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;margin:0 -20px;padding-left:20px;padding-right:20px;scrollbar-width:none;}
.cat-rail::-webkit-scrollbar{display:none;}
.cat{
  flex-shrink:0;padding:11px 18px 11px 14px;
  background:var(--surface);
  border-radius:var(--r-pill);
  display:flex;align-items:center;gap:10px;
  box-shadow:var(--shadow-sm);
  font-family:'Manrope';font-weight:700;font-size:13px;color:var(--ink);
  border:1px solid transparent;
}
.cat i{font-size:13px;color:var(--gold-deep);}
.cat.on{background:var(--espresso);color:var(--gold);border-color:var(--gold);}
.cat.on i{color:var(--gold);}
.cat .cnt{font-family:'Manrope';font-size:11px;color:var(--ink-4);font-weight:600;margin-left:2px;}
.cat.on .cnt{color:var(--gold-soft);}

/* Trending products (horizontal) */
.trend-rail{display:flex;gap:14px;overflow-x:auto;margin:14px -20px 0;padding:6px 20px 16px;scrollbar-width:none;}
.trend-rail::-webkit-scrollbar{display:none;}
.trend-card{
  flex-shrink:0;width:220px;
  background:var(--surface);border-radius:var(--r-xl);
  box-shadow:var(--shadow-sm);
  overflow:hidden;
  position:relative;
  display:flex;flex-direction:column;
}
.trend-card .tc-img{height:140px;background:var(--bg-deep);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;}
.trend-card .tc-img .iph{font-size:80px;color:var(--ink-4);opacity:.5;}
.trend-card .tc-img.iphone{background:linear-gradient(135deg,#1d1d1f 0%,#000 100%);}
.trend-card .tc-img.iphone .iph{color:#E5C07B;opacity:.9;}
.trend-card .tc-img.tv{background:linear-gradient(135deg,#2c3e50 0%,#1a2635 100%);}
.trend-card .tc-img.tv .iph{color:#5DADE2;opacity:.7;}
.trend-card .tc-img.coffee{background:linear-gradient(135deg,#6F4E37 0%,#3E2A1D 100%);}
.trend-card .tc-img.coffee .iph{color:#D7B589;}
.trend-card .tc-img.shoe{background:linear-gradient(135deg,#F5F1EA 0%,#E4DED1 100%);}
.trend-card .tc-img.shoe .iph{color:#8B6F4E;}
.tc-fav{position:absolute;top:12px;right:12px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.94);display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--ink-3);box-shadow:0 4px 10px rgba(0,0,0,.1);}
.tc-fav.on{color:#E04A3F;}
.tc-badge{position:absolute;top:12px;left:12px;padding:5px 10px;border-radius:var(--r-pill);background:rgba(26,17,10,.82);backdrop-filter:blur(8px);color:var(--gold);font-family:'Manrope';font-weight:800;font-size:10px;letter-spacing:.08em;text-transform:uppercase;display:flex;align-items:center;gap:5px;}
.tc-badge.up{background:rgba(180,66,47,.9);color:#fff;}
.tc-badge.down{background:rgba(62,125,79,.92);color:#fff;}
.tc-body{padding:14px 16px 14px;flex:1;display:flex;flex-direction:column;}
.tc-cat{font-family:'Manrope';font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);font-weight:700;}
.tc-title{font-family:'Fraunces',serif;font-weight:600;font-size:15px;line-height:1.25;letter-spacing:-.01em;margin:4px 0 8px;color:var(--ink);min-height:36px;}
.tc-price{display:flex;align-items:baseline;gap:4px;}
.tc-price .p{font-family:'Fraunces',serif;font-weight:700;font-size:22px;color:var(--ink);letter-spacing:-.02em;}
.tc-price .c{font-family:'Manrope';font-weight:700;font-size:12px;color:var(--ink-3);margin-left:2px;}
.tc-meta{margin-top:8px;display:flex;align-items:center;gap:6px;font-family:'Manrope';font-size:11px;color:var(--ink-3);}
.tc-meta .avatar{width:18px;height:18px;border-radius:50%;background:var(--gold);color:var(--espresso);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;}
.tc-meta strong{color:var(--ink-2);font-weight:700;}
.tc-trust{display:inline-flex;align-items:center;gap:3px;margin-left:auto;color:var(--positive);font-weight:700;}

/* Live feed list */
.feed-item{
  display:flex;gap:14px;padding:16px 18px;
  background:var(--surface);border-radius:var(--r-lg);
  margin-top:10px;box-shadow:var(--shadow-sm);
  align-items:center;
}
.feed-thumb{width:52px;height:52px;border-radius:14px;background:var(--bg-deep);flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--ink-3);font-size:18px;}
.feed-thumb.a{background:linear-gradient(135deg,#1d1d1f 0%,#000 100%);color:#E5C07B;}
.feed-thumb.b{background:linear-gradient(135deg,#6F4E37 0%,#3E2A1D 100%);color:#D7B589;}
.feed-thumb.c{background:linear-gradient(135deg,#F5F1EA 0%,#E4DED1 100%);color:#8B6F4E;}
.feed-thumb.d{background:linear-gradient(135deg,#2c3e50 0%,#1a2635 100%);color:#5DADE2;}
.feed-body{flex:1;min-width:0;}
.feed-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px;}
.feed-title{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.feed-store{font-family:'Manrope';font-size:11px;color:var(--ink-3);margin-top:2px;display:flex;align-items:center;gap:6px;}
.feed-store .sep{width:3px;height:3px;border-radius:50%;background:var(--ink-4);display:inline-block;}
.feed-price{font-family:'Fraunces',serif;font-weight:700;font-size:18px;color:var(--ink);letter-spacing:-.02em;white-space:nowrap;}
.feed-price .c{font-family:'Manrope';font-weight:700;font-size:10px;color:var(--ink-3);margin-left:1px;}
.feed-trend{font-family:'Manrope';font-size:10.5px;font-weight:800;margin-top:3px;text-align:right;letter-spacing:.02em;}
.feed-trend.dn{color:var(--positive);}
.feed-trend.up{color:var(--negative);}

/* ============================================================
   BOTTOM NAV
   ============================================================ */
.botnav{
  position:absolute;left:14px;right:14px;bottom:14px;
  height:var(--nav-h);
  background:rgba(255,255,255,.82);
  backdrop-filter:blur(18px) saturate(160%);
  -webkit-backdrop-filter:blur(18px) saturate(160%);
  border:1px solid rgba(26,17,10,.06);
  border-radius:32px;
  display:flex;align-items:center;justify-content:space-around;
  box-shadow:
    0 1px 0 rgba(255,255,255,.7) inset,
    0 20px 40px rgba(26,17,10,.14),
    0 6px 14px rgba(26,17,10,.1);
  z-index:40;
  padding:0 12px;
}
/* bottom nav on dark profile — boost contrast with warmer glow */
.device.on-dark .botnav{
  background:rgba(35,23,16,.72);
  border:1px solid rgba(201,160,99,.18);
  box-shadow:
    0 1px 0 rgba(201,160,99,.1) inset,
    0 20px 40px rgba(0,0,0,.45),
    0 6px 14px rgba(0,0,0,.35);
}
.device.on-dark .nav-item{color:var(--ink-on-dark-3);}
.device.on-dark .nav-item.on{color:var(--gold);}
.device.on-dark .nav-item.fab .lbl{color:var(--ink-on-dark-3);}
.nav-item{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
  color:var(--ink-3);padding:6px 4px;border-radius:22px;
  transition:all .2s ease;font-family:'Manrope';font-weight:700;font-size:10px;letter-spacing:.02em;
}
.nav-item i{font-size:18px;}
.nav-item.on{color:var(--espresso);}
.nav-item.on span{font-weight:800;}
.nav-item.fab{position:relative;top:-22px;}
.nav-fab{
  width:62px;height:62px;border-radius:20px;
  background:linear-gradient(145deg,#2e2016 0%,#1a110a 100%);
  color:var(--gold);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;
  box-shadow:
    0 8px 22px rgba(26,17,10,.35),
    inset 0 1px 0 rgba(201,160,99,.22),
    inset 0 0 0 1px rgba(201,160,99,.14);
  transform:rotate(12deg);
}
.nav-fab svg{transform:rotate(-12deg);}
.nav-item svg{transition:transform .2s ease;}
.nav-item.on svg{transform:translateY(-1px);}
.nav-item.fab .lbl{margin-top:6px;font-size:10px;color:var(--ink-3);font-weight:700;}

/* Page fade-in */
.page{animation:pgIn .35s ease both;}
@keyframes pgIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

/* Utility */
.px{padding-left:var(--pad);padding-right:var(--pad);}
.mt-24{margin-top:24px;}.mt-16{margin-top:16px;}.mt-12{margin-top:12px;}.mt-8{margin-top:8px;}
.row{display:flex;align-items:center;gap:10px;}
.hide{display:none !important;}

/* ============================================================
   PAGE HEADER (back + title, for sub pages)
   ============================================================ */
.ph{padding:10px 20px 0;}
.ph .back{width:44px;height:44px;border-radius:14px;background:var(--surface);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-sm);color:var(--ink);font-size:14px;margin-bottom:24px;}
.ph .ov{color:var(--gold-deep);margin-bottom:6px;}
.ph h1{font-family:'Fraunces',serif;font-weight:700;font-size:44px;letter-spacing:-.03em;line-height:1;margin:0;color:var(--ink);}
.ph h1 em{font-style:italic;font-weight:400;color:var(--ink-3);}
.ph .subtitle{margin-top:10px;font-family:'Manrope';font-size:13.5px;color:var(--ink-3);line-height:1.5;}

/* ============================================================
   KEŞFET
   ============================================================ */
#kesfet{background:var(--bg);}
.search-bar{margin:4px 20px 0;padding:14px 16px;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);display:flex;align-items:center;gap:12px;}
.search-bar i{color:var(--ink-3);font-size:15px;}
.search-bar input{flex:1;border:0;outline:0;background:transparent;font-family:'Manrope';font-weight:500;font-size:14px;color:var(--ink);}
.search-bar input::placeholder{color:var(--ink-4);}
.search-bar .filter{width:38px;height:38px;border-radius:12px;background:var(--espresso);color:var(--gold);display:flex;align-items:center;justify-content:center;}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 20px 0;}
.gcard{
  background:var(--surface);border-radius:var(--r-xl);
  box-shadow:var(--shadow-sm);overflow:hidden;display:flex;flex-direction:column;
  position:relative;
}
.gcard .g-img{height:128px;display:flex;align-items:center;justify-content:center;background:var(--bg-deep);position:relative;}
.gcard .g-img i{font-size:52px;color:var(--ink-4);opacity:.6;}
.gcard.a .g-img{background:linear-gradient(135deg,#1d1d1f 0%,#000 100%);}
.gcard.a .g-img i{color:#E5C07B;opacity:.9;}
.gcard.b .g-img{background:linear-gradient(135deg,#2c3e50 0%,#1a2635 100%);}
.gcard.b .g-img i{color:#5DADE2;opacity:.75;}
.gcard.c .g-img{background:linear-gradient(135deg,#F5F1EA 0%,#E4DED1 100%);}
.gcard.c .g-img i{color:#8B6F4E;}
.gcard.d .g-img{background:linear-gradient(135deg,#6F4E37 0%,#3E2A1D 100%);}
.gcard.d .g-img i{color:#D7B589;}
.gcard.e .g-img{background:linear-gradient(135deg,#E74C3C 0%,#922B21 100%);}
.gcard.e .g-img i{color:#fff;opacity:.85;}
.gcard.f .g-img{background:linear-gradient(135deg,#9B59B6 0%,#5B2C6F 100%);}
.gcard.f .g-img i{color:#fff;opacity:.85;}
.gcard .g-fav{position:absolute;top:10px;right:10px;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.94);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--ink-3);}
.gcard .g-fav.on{color:#E04A3F;}
.gcard .g-trend{position:absolute;top:10px;left:10px;padding:4px 8px;border-radius:var(--r-pill);font-size:9.5px;font-weight:800;letter-spacing:.05em;font-family:'Manrope';text-transform:uppercase;display:flex;align-items:center;gap:4px;}
.gcard .g-trend.dn{background:rgba(62,125,79,.92);color:#fff;}
.gcard .g-trend.up{background:rgba(180,66,47,.92);color:#fff;}
.gcard .g-body{padding:12px 14px 14px;flex:1;display:flex;flex-direction:column;}
.gcard .g-cat{font-family:'Manrope';font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);font-weight:700;}
.gcard .g-title{font-family:'Fraunces',serif;font-weight:600;font-size:13.5px;line-height:1.22;margin:4px 0 8px;color:var(--ink);min-height:32px;letter-spacing:-.005em;}
.gcard .g-price{display:flex;align-items:baseline;gap:3px;margin-top:auto;}
.gcard .g-price .p{font-family:'Fraunces',serif;font-weight:700;font-size:18px;color:var(--ink);letter-spacing:-.02em;}
.gcard .g-price .c{font-family:'Manrope';font-weight:700;font-size:10px;color:var(--ink-3);}
.gcard .g-foot{margin-top:6px;font-family:'Manrope';font-size:10.5px;color:var(--ink-3);display:flex;align-items:center;gap:4px;}
.gcard .g-foot .av{width:16px;height:16px;border-radius:50%;background:var(--gold);color:var(--espresso);display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;}

/* ============================================================
   EKLE
   ============================================================ */
#ekle{background:var(--bg);}
.ekle-hero{margin:4px 20px 0;padding:20px 22px;background:linear-gradient(135deg,#231710 0%,#1a110a 100%);border-radius:var(--r-2xl);color:var(--ink-on-dark);position:relative;overflow:hidden;}
.ekle-hero::before{content:"";position:absolute;right:-40px;top:-40px;width:180px;height:180px;background:radial-gradient(circle,rgba(201,160,99,.25),transparent 65%);}
.ekle-hero .ov{color:var(--gold);}
.ekle-hero h2{font-family:'Fraunces',serif;font-weight:700;font-size:26px;margin:6px 0 4px;letter-spacing:-.02em;line-height:1.1;}
.ekle-hero h2 em{font-style:italic;font-weight:400;color:var(--gold-soft);}
.ekle-hero .p{font-family:'Manrope';font-size:12.5px;color:var(--ink-on-dark-2);max-width:80%;line-height:1.5;}
.ekle-hero .reward{margin-top:14px;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:var(--r-pill);background:rgba(201,160,99,.18);border:1px solid rgba(201,160,99,.35);color:var(--gold);font-family:'Manrope';font-weight:700;font-size:12px;letter-spacing:.02em;position:relative;z-index:2;}

.form-sec{margin:22px 20px 0;}
.form-sec .fs-label{display:block;font-family:'Manrope';font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px;}
.input-grp{background:var(--surface);border-radius:var(--r-lg);padding:14px 16px;box-shadow:var(--shadow-sm);display:flex;align-items:center;gap:12px;}
.input-grp i{color:var(--ink-3);font-size:14px;}
.input-grp input,.input-grp select{flex:1;border:0;outline:0;background:transparent;font-family:'Manrope';font-weight:600;font-size:14px;color:var(--ink);appearance:none;-webkit-appearance:none;}
.input-grp .suf{font-family:'Manrope';font-weight:700;font-size:13px;color:var(--ink-3);}
.input-grp .suf-btn{padding:7px 12px;border-radius:var(--r-pill);background:var(--gold-wash);color:var(--gold-deep);font-family:'Manrope';font-weight:700;font-size:11.5px;display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(201,160,99,.25);}
.input-grp .suf-btn:active{transform:scale(.96);}

.note-grp{background:var(--surface);border-radius:var(--r-lg);padding:14px 16px 10px;box-shadow:var(--shadow-sm);}
.note-grp textarea{width:100%;min-height:80px;resize:none;border:0;outline:0;background:transparent;font-family:'Manrope';font-weight:500;font-size:13.5px;color:var(--ink);line-height:1.5;}
.note-grp textarea::placeholder{color:var(--ink-4);}
.note-foot{margin-top:10px;padding-top:10px;border-top:1px dashed var(--bg-deep);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
.note-chips{display:flex;gap:6px;flex-wrap:wrap;flex:1;min-width:0;}
.note-chip{padding:6px 10px;border-radius:var(--r-pill);background:var(--bg-soft);color:var(--ink-2);font-family:'Manrope';font-weight:600;font-size:11px;border:1px solid var(--bg-deep);}
.note-chip.on{background:var(--gold-wash);color:var(--gold-deep);border-color:rgba(201,160,99,.3);}
.note-count{font-family:'Manrope';font-weight:700;font-size:10.5px;color:var(--ink-4);white-space:nowrap;}

.chips-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
.ch{padding:9px 14px;border-radius:var(--r-pill);background:var(--surface);font-family:'Manrope';font-weight:700;font-size:12px;color:var(--ink-2);box-shadow:var(--shadow-sm);border:1px solid transparent;}
.ch.on{background:var(--espresso);color:var(--gold);border-color:var(--gold);}

.submit-row{margin:28px 20px 0;}
.submit-cta{width:100%;padding:18px;border-radius:var(--r-pill);background:linear-gradient(135deg,#C9A063 0%,#A57E46 100%);color:var(--espresso);font-family:'Manrope';font-weight:800;font-size:15px;letter-spacing:.02em;box-shadow:var(--shadow-gold);display:flex;align-items:center;justify-content:center;gap:10px;}

.notice{margin:18px 20px 0;padding:14px 16px;background:var(--gold-wash);border-radius:var(--r-lg);display:flex;gap:12px;align-items:flex-start;border:1px solid rgba(201,160,99,.25);}
.notice i{color:var(--gold-deep);font-size:14px;margin-top:2px;}
.notice .txt{font-family:'Manrope';font-size:12px;color:var(--ink-2);line-height:1.5;}
.notice .txt strong{color:var(--ink);font-weight:800;}

/* ============================================================
   SEPET
   ============================================================ */
#sepet{background:var(--bg);}
.tab-switch{margin:4px 20px 0;background:var(--surface);border-radius:var(--r-pill);padding:4px;display:flex;box-shadow:var(--shadow-sm);}
.tab-switch button{flex:1;padding:11px 10px;border-radius:var(--r-pill);font-family:'Manrope';font-weight:700;font-size:13px;color:var(--ink-3);display:flex;align-items:center;justify-content:center;gap:8px;}
.tab-switch button.on{background:var(--espresso);color:var(--gold);box-shadow:0 6px 14px rgba(26,17,10,.2);}
.tab-switch .n{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--bg-deep);color:var(--ink-2);font-size:11px;font-weight:800;}
.tab-switch button.on .n{background:var(--gold);color:var(--espresso);}

.sepet-item{margin:12px 20px 0;padding:14px 16px;background:var(--surface);border-radius:var(--r-lg);display:flex;gap:14px;align-items:center;box-shadow:var(--shadow-sm);}
.sepet-item .si-thumb{width:54px;height:54px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.sepet-item .si-thumb.a{background:linear-gradient(135deg,#1d1d1f 0%,#000 100%);color:#E5C07B;}
.sepet-item .si-thumb.b{background:linear-gradient(135deg,#6F4E37 0%,#3E2A1D 100%);color:#D7B589;}
.sepet-item .si-thumb.c{background:linear-gradient(135deg,#F5F1EA 0%,#E4DED1 100%);color:#8B6F4E;}
.sepet-item .si-body{flex:1;min-width:0;}
.sepet-item .si-title{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sepet-item .si-sub{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:2px;}
.sepet-item .si-qty{display:flex;align-items:center;gap:10px;}
.sepet-item .qbtn{width:28px;height:28px;border-radius:10px;background:var(--bg-deep);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;}
.sepet-item .qval{font-family:'Manrope';font-weight:800;font-size:14px;min-width:18px;text-align:center;}
.sepet-item .remove{color:var(--negative);font-size:14px;}

.query-cta{margin:22px 20px 0;padding:18px;border-radius:var(--r-pill);background:linear-gradient(135deg,#C9A063 0%,#A57E46 100%);color:var(--espresso);font-family:'Manrope';font-weight:800;font-size:15px;letter-spacing:.02em;box-shadow:var(--shadow-gold);display:flex;align-items:center;justify-content:center;gap:10px;width:calc(100% - 40px);}

/* Hero best */
.hero-best{
  margin:14px 20px 0;
  padding:24px 22px 22px;
  border-radius:var(--r-2xl);
  background:linear-gradient(145deg,#2e5c3a 0%,#1f4026 100%);
  color:#eef6e7;position:relative;overflow:hidden;
  box-shadow:0 14px 40px rgba(31,64,38,.35);
}
.hero-best::before{content:"";position:absolute;top:-30px;right:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(255,255,255,.12),transparent 65%);}
.hero-best .cr{position:absolute;top:20px;right:22px;font-size:22px;color:#EAD79F;filter:drop-shadow(0 2px 6px rgba(0,0,0,.3));}
.hero-best .ov{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:#EAD79F;display:flex;align-items:center;gap:8px;}
.hero-best .ov::before{content:"";width:22px;height:1px;background:#EAD79F;opacity:.6;}
.hero-best .st{font-family:'Fraunces',serif;font-weight:700;font-size:26px;letter-spacing:-.02em;line-height:1.1;margin-top:10px;}
.hero-best .st em{font-style:italic;font-weight:400;color:#EAD79F;}
.hero-best .pr{margin-top:16px;display:flex;align-items:baseline;gap:8px;}
.hero-best .pr .num{font-family:'Fraunces',serif;font-weight:700;font-size:48px;letter-spacing:-.03em;line-height:1;}
.hero-best .pr .cur{font-family:'Manrope';font-weight:800;font-size:18px;color:#EAD79F;margin-left:2px;}
.hero-best .saving{margin-top:8px;font-family:'Manrope';font-weight:700;font-size:13px;color:#EAD79F;display:flex;align-items:center;gap:8px;}
.hero-best .row-cta{margin-top:18px;display:flex;gap:8px;position:relative;z-index:2;}
.hero-best .rc{flex:1;padding:12px 14px;border-radius:var(--r-pill);background:rgba(255,255,255,.14);font-family:'Manrope';font-weight:700;font-size:12.5px;color:#fff;display:flex;align-items:center;justify-content:center;gap:8px;border:1px solid rgba(255,255,255,.18);}
.hero-best .rc.primary{background:#fff;color:#1f4026;}

/* Result row */
.res-row{
  margin:10px 20px 0;padding:14px 16px;
  background:var(--surface);border-radius:var(--r-lg);
  display:flex;align-items:center;gap:14px;box-shadow:var(--shadow-sm);
}
.res-rank{width:34px;height:34px;border-radius:12px;background:var(--bg-deep);color:var(--ink-2);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:14px;flex-shrink:0;}
.res-body{flex:1;min-width:0;}
.res-name{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);}
.res-meta{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:3px;display:flex;align-items:center;gap:6px;}
.res-pr{font-family:'Fraunces',serif;font-weight:700;font-size:20px;color:var(--ink);letter-spacing:-.02em;white-space:nowrap;}
.res-pr .c{font-family:'Manrope';font-weight:700;font-size:11px;color:var(--ink-3);margin-left:2px;}
.res-diff{font-family:'Manrope';font-size:10.5px;font-weight:800;color:var(--ink-3);margin-top:3px;text-align:right;}
.res-diff.up{color:var(--negative);}

/* Per-product breakdown (sepet sonuçlar) */
.prod-brk{margin:10px 20px 0;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);overflow:hidden;}
.pb-head{padding:16px 18px 12px;display:flex;align-items:center;gap:12px;border-bottom:1px dashed var(--bg-deep);}
.pb-thumb{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.pb-thumb.a{background:linear-gradient(135deg,#1d1d1f,#000);}
.pb-thumb.b{background:linear-gradient(135deg,#6F4E37,#3E2A1D);}
.pb-thumb.c{background:linear-gradient(135deg,#F5F1EA,#E4DED1);}
.pb-info{flex:1;min-width:0;}
.pb-title{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);}
.pb-sub{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:2px;}
.pb-stores{padding:6px 0;}
.pb-store{padding:12px 18px;display:flex;align-items:center;gap:12px;}
.pb-store + .pb-store{border-top:1px solid var(--bg-deep);}
.pb-store.best{background:linear-gradient(90deg, rgba(62,125,79,.06), transparent);}
.pbs-rank{width:26px;height:26px;border-radius:8px;background:var(--bg-deep);color:var(--ink-2);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:12px;flex-shrink:0;}
.pb-store.best .pbs-rank{background:linear-gradient(135deg,#E8C589,#C9A063);color:var(--espresso);box-shadow:0 3px 8px rgba(201,160,99,.3);}
.pbs-body{flex:1;min-width:0;}
.pbs-store{font-family:'Manrope';font-weight:700;font-size:13px;color:var(--ink);}
.pbs-tag{font-family:'Manrope';font-size:10.5px;font-weight:700;margin-top:2px;color:var(--positive);letter-spacing:.02em;}
.pbs-tag.up{color:var(--negative);}
.pbs-tag.dn{color:var(--neutral);}
.pbs-pr{font-family:'Fraunces',serif;font-weight:700;font-size:17px;color:var(--ink);letter-spacing:-.02em;white-space:nowrap;}
.pbs-pr .c{font-family:'Manrope';font-weight:700;font-size:10px;color:var(--ink-3);margin-left:2px;}
.pb-store.best .pbs-pr{color:var(--positive);}

/* ============================================================
   PROFIL (dark page)
   ============================================================ */
#profil{
  background:
    radial-gradient(700px 400px at 10% 0%, rgba(201,160,99,.14) 0%, transparent 55%),
    radial-gradient(500px 300px at 100% 15%, rgba(201,160,99,.08) 0%, transparent 55%),
    linear-gradient(180deg, #F3F0E9 0%, #EDEAE3 100%);
  color:var(--ink);min-height:900px;
}
.pr-head{padding:10px 20px 0;display:flex;justify-content:space-between;align-items:flex-start;}
.pr-head h1{font-family:'Fraunces',serif;font-weight:700;font-size:44px;margin:0;letter-spacing:-.03em;color:var(--ink);}
.pr-head .settings-ic{width:44px;height:44px;border-radius:14px;background:var(--surface);border:1px solid var(--bg-deep);display:flex;align-items:center;justify-content:center;color:var(--espresso);font-size:16px;box-shadow:var(--shadow-sm);}

/* Hero profile card (now cream base with espresso accent gradient top) */
.pr-card{margin:20px 20px 0;padding:28px 24px 32px;background:var(--surface);border-radius:var(--r-2xl);text-align:center;position:relative;border:1px solid var(--bg-deep);overflow:hidden;box-shadow:var(--shadow-md);}
.pr-card::before{content:"";position:absolute;top:0;left:0;right:0;height:120px;background:linear-gradient(180deg,#231710 0%,#2a1d11 100%);pointer-events:none;}
.pr-card::after{content:"";position:absolute;top:0;right:-40px;width:200px;height:160px;background:radial-gradient(circle at 40% 30%,rgba(201,160,99,.28),transparent 60%);pointer-events:none;}
.pr-avatar{width:118px;height:118px;margin:0 auto;border-radius:32px;background:linear-gradient(145deg,#FAF7F1,#EDEAE3);display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 0 0 4px rgba(201,160,99,.35),0 0 0 7px #fff,0 12px 30px rgba(26,17,10,.25);z-index:2;}
.pr-avatar .logo{font-family:'Fraunces',serif;font-weight:800;font-size:46px;color:var(--espresso);letter-spacing:-.04em;line-height:1;display:flex;flex-direction:column;align-items:center;}
.pr-avatar .logo .dot{width:10px;height:10px;border-radius:50%;background:var(--gold);margin-top:-4px;}
.pr-admin-pill{position:absolute;bottom:-12px;left:50%;transform:translateX(-50%);padding:5px 12px;border-radius:var(--r-pill);background:linear-gradient(135deg,#C9A063,#A57E46);border:2px solid var(--surface);font-family:'Manrope';font-weight:800;font-size:10px;color:#231710;letter-spacing:.12em;display:flex;align-items:center;gap:5px;white-space:nowrap;box-shadow:0 4px 14px rgba(201,160,99,.4);z-index:3;}
.pr-name{margin-top:24px;font-family:'Fraunces',serif;font-weight:700;font-size:30px;color:var(--ink);letter-spacing:-.02em;position:relative;z-index:2;}
.pr-name em{font-style:italic;font-weight:400;color:var(--ink-3);}
.pr-handle{margin-top:4px;font-family:'Manrope';font-size:12.5px;color:var(--ink-3);letter-spacing:.02em;position:relative;z-index:2;}

/* Rank card (espresso dark accent - signature card) */
.rank-card{margin:20px 20px 0;padding:22px;background:linear-gradient(160deg,#231710 0%,#1a110a 100%);border-radius:var(--r-2xl);border:1px solid rgba(201,160,99,.18);position:relative;overflow:hidden;color:var(--ink-on-dark);box-shadow:0 10px 30px rgba(26,17,10,.18);}
.rank-card::before{content:"";position:absolute;top:-20px;right:-20px;width:180px;height:180px;background:radial-gradient(circle,rgba(201,160,99,.22),transparent 65%);pointer-events:none;}
.rank-head{display:flex;justify-content:space-between;align-items:flex-start;}
.rank-head .lb{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);}
.rank-badge{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#E8C589,#C9A063);color:var(--espresso);display:flex;align-items:center;justify-content:center;font-size:15px;box-shadow:0 6px 16px rgba(201,160,99,.4);}
.rank-val{margin-top:12px;display:flex;align-items:baseline;gap:10px;}
.rank-val .num{font-family:'Fraunces',serif;font-weight:700;font-size:72px;letter-spacing:-.04em;color:var(--ink-on-dark);line-height:.95;}
.rank-val .unit{font-family:'Manrope';font-weight:800;font-size:16px;color:var(--gold);letter-spacing:.08em;}
.rank-next{margin-top:10px;font-family:'Manrope';font-size:13px;color:var(--ink-on-dark-2);text-align:center;}
.rank-next strong{color:var(--gold-soft);font-weight:800;}
.rank-bar{margin-top:18px;height:54px;background:rgba(255,255,255,.08);border-radius:18px;padding:0 18px;display:flex;align-items:center;gap:14px;border:1px solid rgba(201,160,99,.2);}
.rank-bar .rb-num{font-family:'Fraunces',serif;font-weight:700;font-size:22px;color:var(--ink-on-dark);}
.rank-bar .rb-lbl{font-family:'Manrope';font-weight:700;font-size:12.5px;color:var(--ink-on-dark-2);}

/* Stats (light cards now) */
.pr-stats{margin:16px 20px 0;display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
.ps{padding:16px 12px;background:var(--surface);border-radius:var(--r-lg);text-align:center;border:1px solid var(--bg-deep);box-shadow:var(--shadow-sm);}
.ps .v{font-family:'Fraunces',serif;font-weight:700;font-size:24px;color:var(--ink);letter-spacing:-.02em;}
.ps .l{margin-top:4px;font-family:'Manrope';font-weight:700;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);}

.pr-over{margin:28px 24px 12px;font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-deep);}
.pr-list{margin:0 20px;background:var(--surface);border-radius:var(--r-xl);border:1px solid var(--bg-deep);overflow:hidden;box-shadow:var(--shadow-sm);}
.pr-list > .pl-item + .pl-item{border-top:1px solid var(--bg-deep);}
.pl-item{display:flex;align-items:center;gap:14px;padding:16px 18px;}
.pl-item .pl-ic{width:38px;height:38px;border-radius:12px;background:var(--gold-wash);color:var(--gold-deep);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.pl-item .pl-tx{flex:1;min-width:0;}
.pl-item .pl-tx .t{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);}
.pl-item .pl-tx .c{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:2px;}
.pl-item .pl-val{font-family:'Manrope';font-weight:800;font-size:11px;color:var(--gold-deep);padding:4px 10px;border-radius:var(--r-pill);background:var(--gold-wash);}
.pl-item .pl-chev{width:18px;height:18px;transform:rotate(45deg);background:var(--bg-deep);border-radius:4px;}

.pl-exec{margin:10px 20px 0;}

.pr-foot{margin:32px 20px 0;padding:0 20px;text-align:center;font-family:'Manrope';font-size:11px;color:var(--ink-3);letter-spacing:.04em;}
.pr-foot .v{margin-top:4px;}

/* ============================================================
   DETAY (product detail)
   ============================================================ */
#detay{background:var(--bg);}
.det-top{padding:6px 20px 0;display:flex;justify-content:space-between;}
.det-top .ic{width:42px;height:42px;border-radius:14px;background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--ink);box-shadow:var(--shadow-sm);font-size:14px;}
.det-top .ic.fav.on{color:#E04A3F;}
.det-hero{margin:14px 20px 0;height:240px;border-radius:var(--r-2xl);background:linear-gradient(135deg,#1d1d1f 0%,#000 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;box-shadow:var(--shadow-md);}
.det-hero i{font-size:140px;color:#E5C07B;opacity:.95;}
.det-hero .badge{position:absolute;top:16px;left:16px;padding:6px 12px;border-radius:var(--r-pill);background:rgba(255,255,255,.14);backdrop-filter:blur(10px);color:#E5C07B;font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:6px;}
.det-dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:5px;}
.det-dots i{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.3);}
.det-dots i.on{width:18px;border-radius:3px;background:#E5C07B;}

.det-info{margin:18px 20px 0;}
.det-info .cat{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-deep);}
.det-info h2{font-family:'Fraunces',serif;font-weight:700;font-size:28px;letter-spacing:-.02em;margin:6px 0 0;line-height:1.1;color:var(--ink);}
.det-pulse{margin-top:14px;padding:18px 20px;background:linear-gradient(135deg,#231710 0%,#1a110a 100%);border-radius:var(--r-xl);color:var(--ink-on-dark);position:relative;overflow:hidden;}
.det-pulse::before{content:"";position:absolute;right:-30px;top:-30px;width:140px;height:140px;background:radial-gradient(circle,rgba(201,160,99,.2),transparent 65%);}
.det-pulse .ov{font-family:'Manrope';font-weight:800;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);}
.det-pulse .row{margin-top:8px;display:flex;justify-content:space-between;align-items:baseline;}
.det-pulse .l .num{font-family:'Fraunces',serif;font-weight:700;font-size:36px;letter-spacing:-.02em;color:var(--ink-on-dark);}
.det-pulse .l .unit{font-family:'Manrope';font-weight:800;font-size:14px;color:var(--gold);margin-left:4px;}
.det-pulse .l .sub{font-family:'Manrope';font-size:11.5px;color:var(--ink-on-dark-3);margin-top:2px;}
.det-pulse .r{text-align:right;}
.det-pulse .trend{font-family:'Manrope';font-weight:800;font-size:13px;color:#8bc59b;}
.det-pulse .trend.up{color:#E8967F;}
.det-pulse .tr-sub{font-family:'Manrope';font-size:10.5px;color:var(--ink-on-dark-3);margin-top:2px;}

/* Sparkline */
.spark{margin-top:14px;height:56px;width:100%;position:relative;}

.det-sec-head{margin:28px 20px 12px;display:flex;align-items:center;justify-content:space-between;}
.det-sec-head .ov{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-3);}
.det-sec-head .cnt{font-family:'Manrope';font-weight:800;font-size:11px;color:var(--gold-deep);padding:4px 10px;border-radius:var(--r-pill);background:var(--gold-wash);}

.price-entry{margin:10px 20px 0;padding:16px;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);}
.pe-head{display:flex;align-items:center;gap:12px;}
.pe-av{width:44px;height:44px;border-radius:14px;background:var(--gold);color:var(--espresso);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:800;font-size:17px;letter-spacing:-.02em;flex-shrink:0;position:relative;}
.pe-av.verified::after{content:"\f00c";font-family:"Font Awesome 6 Free";font-weight:900;position:absolute;bottom:-4px;right:-4px;width:18px;height:18px;border-radius:50%;background:var(--positive);color:#fff;font-size:8px;display:flex;align-items:center;justify-content:center;border:2px solid var(--surface);}
.pe-nm{flex:1;min-width:0;}
.pe-nm .n{font-family:'Manrope';font-weight:700;font-size:13.5px;color:var(--ink);display:flex;align-items:center;gap:6px;}
.pe-nm .n .tier{font-family:'Manrope';font-weight:800;font-size:9.5px;letter-spacing:.08em;color:var(--gold-deep);background:var(--gold-wash);padding:2px 6px;border-radius:4px;}
.pe-nm .c{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:2px;}
.pe-time{font-family:'Manrope';font-weight:700;font-size:11px;color:var(--ink-3);text-align:right;}
.pe-body{margin-top:14px;padding:14px;background:var(--bg-soft);border-radius:var(--r-md);display:flex;justify-content:space-between;align-items:center;}
.pe-body .store{display:flex;align-items:center;gap:10px;}
.pe-body .store-ic{width:36px;height:36px;border-radius:10px;background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--ink-2);font-size:14px;}
.pe-body .store-nm{font-family:'Manrope';font-weight:700;font-size:13.5px;color:var(--ink);}
.pe-body .store-ad{font-family:'Manrope';font-size:11px;color:var(--ink-3);margin-top:1px;display:flex;align-items:center;gap:5px;}
.pe-body .pe-pr{font-family:'Fraunces',serif;font-weight:700;font-size:22px;letter-spacing:-.02em;color:var(--ink);}
.pe-body .pe-pr .c{font-family:'Manrope';font-weight:800;font-size:11px;color:var(--ink-3);margin-left:2px;}
.pe-actions{margin-top:12px;display:flex;gap:8px;}
.pe-btn{flex:1;padding:10px;border-radius:var(--r-pill);background:var(--bg-deep);color:var(--ink);font-family:'Manrope';font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;gap:6px;}
.pe-btn.up{background:var(--positive-soft);color:var(--positive);}
.pe-btn.dn{background:var(--negative-soft);color:var(--negative);}
.pe-btn.gold{background:var(--espresso);color:var(--gold);}

.det-cta{position:sticky;bottom:calc(var(--nav-h) + 22px);margin:22px 20px 0;display:flex;gap:10px;}
.det-cta .main{flex:1;padding:16px;border-radius:var(--r-pill);background:linear-gradient(135deg,#C9A063 0%,#A57E46 100%);color:var(--espresso);font-family:'Manrope';font-weight:800;font-size:14px;box-shadow:var(--shadow-gold);display:flex;align-items:center;justify-content:center;gap:8px;}
.det-cta .alt{padding:16px 20px;border-radius:var(--r-pill);background:var(--espresso);color:var(--gold);font-family:'Manrope';font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;gap:8px;}

/* ============================================================
   SUB PAGES (settings/ayarlar, notifications, sürüm notları etc.)
   ============================================================ */
#ayarlar{background:var(--bg);}
.group{margin:24px 20px 0;}
.group .lbl{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-3);margin-bottom:12px;padding-left:4px;}
.group .pack{background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);overflow:hidden;}
.group .row-item{display:flex;align-items:center;gap:14px;padding:16px 18px;}
.group .row-item + .row-item{border-top:1px solid var(--bg-deep);}
.group .row-item .ic{width:30px;display:flex;align-items:center;justify-content:center;color:var(--ink-2);font-size:15px;}
.group .row-item .t{flex:1;font-family:'Manrope';font-weight:700;font-size:14.5px;color:var(--ink);}
.group .row-item .chev{width:18px;height:18px;transform:rotate(45deg);background:var(--bg-deep);border-radius:4px;}
.logout-btn{margin:28px 20px 0;padding:16px;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);display:flex;justify-content:center;align-items:center;gap:10px;width:calc(100% - 40px);}
.delete-btn{margin:12px 20px 0;padding:16px;background:var(--negative-soft);border-radius:var(--r-xl);font-family:'Manrope';font-weight:700;font-size:14px;color:var(--negative);display:flex;justify-content:center;align-items:center;gap:10px;width:calc(100% - 40px);}

/* Version notes page */
#surum{background:var(--bg);}
.vn-card{margin:22px 20px 0;padding:24px;border-radius:var(--r-2xl);position:relative;overflow:hidden;box-shadow:var(--shadow-md);}
.vn-card.dark{background:linear-gradient(150deg,#231710 0%,#170f07 100%);color:var(--ink-on-dark);border:1px solid rgba(201,160,99,.12);}
.vn-card.dark::before{content:"";position:absolute;top:-20px;right:-20px;width:180px;height:180px;background:radial-gradient(circle,rgba(201,160,99,.2),transparent 65%);}
.vn-card.light{background:var(--surface);}
.vn-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;position:relative;z-index:2;}
.vn-pill{padding:7px 16px;border-radius:var(--r-pill);background:rgba(201,160,99,.18);border:1px solid rgba(201,160,99,.3);color:var(--gold);font-family:'Manrope';font-weight:800;font-size:12px;display:inline-flex;align-items:center;gap:6px;}
.vn-card.light .vn-pill{background:var(--bg-deep);border-color:transparent;color:var(--ink-2);}
.vn-pill .dot{width:6px;height:6px;border-radius:50%;background:var(--gold);}
.vn-date{font-family:'Manrope';font-weight:600;font-size:12px;color:var(--ink-on-dark-2);}
.vn-card.light .vn-date{color:var(--ink-3);}
.vn-title{font-family:'Fraunces',serif;font-weight:700;font-size:24px;letter-spacing:-.02em;line-height:1.1;margin-bottom:14px;}
.vn-card.light .vn-title{color:var(--ink);}
.vn-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;}
.vn-list li{display:flex;gap:12px;}
.vn-list .dmk{width:22px;height:22px;transform:rotate(45deg);background:rgba(201,160,99,.2);border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:3px;}
.vn-card.light .vn-list .dmk{background:var(--gold-wash);}
.vn-list .dmk::before{content:"";width:7px;height:7px;background:var(--gold);border-radius:2px;transform:rotate(0deg);}
.vn-list .bd{font-family:'Manrope';font-size:13.5px;line-height:1.55;color:var(--ink-on-dark-2);}
.vn-card.light .vn-list .bd{color:var(--ink-2);}
.vn-list strong{color:var(--ink-on-dark);font-weight:800;}
.vn-card.light .vn-list strong{color:var(--ink);}

/* Notifications center */
#bildirim{background:var(--bg);}
.noti-item{margin:10px 20px 0;padding:14px 16px;background:var(--surface);border-radius:var(--r-lg);display:flex;gap:12px;box-shadow:var(--shadow-sm);}
.noti-item.unread{background:linear-gradient(90deg,rgba(201,160,99,.06),transparent);border-left:3px solid var(--gold);}
.noti-ic{width:38px;height:38px;border-radius:12px;background:var(--gold-wash);color:var(--gold-deep);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.noti-ic.up{background:var(--negative-soft);color:var(--negative);}
.noti-ic.dn{background:var(--positive-soft);color:var(--positive);}
.noti-ic.pts{background:var(--espresso);color:var(--gold);}
.noti-body{flex:1;min-width:0;}
.noti-title{font-family:'Manrope';font-weight:700;font-size:13.5px;color:var(--ink);}
.noti-title strong{font-weight:800;color:var(--ink);}
.noti-sub{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:2px;}
.noti-time{font-family:'Manrope';font-weight:700;font-size:10.5px;color:var(--ink-4);text-align:right;white-space:nowrap;}

/* ============================================================
   ADMIN
   ============================================================ */
#admin{background:var(--bg);}
.admin-tabs{margin:14px 0 0;padding:0 20px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;}
.admin-tabs::-webkit-scrollbar{display:none;}
.adt{flex-shrink:0;padding:9px 14px;border-radius:var(--r-pill);background:var(--surface);color:var(--ink-2);font-family:'Manrope';font-weight:700;font-size:12.5px;display:flex;align-items:center;gap:7px;box-shadow:var(--shadow-sm);}
.adt.on{background:var(--espresso);color:var(--gold);}
.adt .c{padding:1px 7px;border-radius:999px;background:var(--gold-wash);color:var(--gold-deep);font-size:10px;font-weight:800;}
.adt.on .c{background:rgba(201,160,99,.22);color:var(--gold);}

.admin-grid{margin:14px 20px 0;display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.ag{padding:16px;background:var(--surface);border-radius:var(--r-lg);box-shadow:var(--shadow-sm);}
.ag .k{font-family:'Manrope';font-weight:800;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);}
.ag .v{font-family:'Fraunces',serif;font-weight:700;font-size:28px;letter-spacing:-.02em;color:var(--ink);margin-top:6px;}
.ag .v em{font-family:'Manrope';font-weight:800;font-size:11px;color:var(--positive);margin-left:6px;}
.ag .v em.up{color:var(--negative);}

.admin-tab{display:none;}
.admin-tab.on{display:block;}

.admin-row{margin:10px 20px 0;padding:14px 16px;background:var(--surface);border-radius:var(--r-lg);display:flex;gap:12px;align-items:center;box-shadow:var(--shadow-sm);}
.admin-row .ar-thumb{width:46px;height:46px;border-radius:12px;background:var(--bg-deep);display:flex;align-items:center;justify-content:center;color:var(--ink-3);font-size:16px;flex-shrink:0;}
.admin-row .ar-body{flex:1;min-width:0;}
.admin-row .ar-body .t{font-family:'Manrope';font-weight:700;font-size:13.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.admin-row .ar-body .s{font-family:'Manrope';font-size:11px;color:var(--ink-3);margin-top:2px;display:flex;align-items:center;gap:6px;}
.admin-row .ar-actions{display:flex;gap:6px;}
.admin-row .ar-ic{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:12px;}
.admin-row .ar-ic.approve{background:var(--positive-soft);color:var(--positive);}
.admin-row .ar-ic.reject{background:var(--negative-soft);color:var(--negative);}
.admin-row .ar-ic.edit{background:var(--gold-wash);color:var(--gold-deep);}
.admin-row .ar-ic.photo{background:rgba(155,89,182,.14);color:#7D3C98;}
.admin-row .ar-ic.view{background:var(--bg-deep);color:var(--ink-2);}

.settings-pack{margin:16px 20px 0;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);overflow:hidden;}
.settings-pack .sp-item{display:flex;align-items:center;gap:14px;padding:16px 18px;}
.settings-pack .sp-item + .sp-item{border-top:1px solid var(--bg-deep);}
.settings-pack .sp-item .ic{width:32px;color:var(--ink-2);font-size:14px;}
.settings-pack .sp-item .t{flex:1;font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);}
.settings-pack .sp-item .t .s{display:block;font-family:'Manrope';font-weight:500;font-size:11.5px;color:var(--ink-3);margin-top:2px;}
.switch{width:42px;height:25px;background:var(--bg-deep);border-radius:999px;position:relative;cursor:pointer;transition:.2s;}
.switch::after{content:"";width:19px;height:19px;border-radius:50%;background:#fff;position:absolute;top:3px;left:3px;box-shadow:0 2px 4px rgba(0,0,0,.15);transition:.2s;}
.switch.on{background:var(--positive);}
.switch.on::after{left:20px;}

/* Banner Management (admin) */
.bnr-card{margin:10px 20px 0;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);overflow:hidden;}
.bnr-preview{height:96px;padding:16px 18px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;}
.bnr-preview.b1{background:linear-gradient(115deg,#2a1d11 0%,#1a110a 100%);color:var(--ink-on-dark);}
.bnr-preview.b2{background:linear-gradient(115deg,#3E7D4F 0%,#2e5c3a 100%);color:#f0f7ea;}
.bnr-preview.b3{background:linear-gradient(115deg,#BF9470 0%,#8d6640 100%);color:#fff;}
.bnr-over{font-family:'Manrope';font-weight:800;font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;opacity:.8;}
.bnr-preview.b1 .bnr-over{color:var(--gold);opacity:1;}
.bnr-head{font-family:'Fraunces',serif;font-weight:700;font-size:18px;letter-spacing:-.01em;line-height:1.15;}
.bnr-head em{font-style:italic;font-weight:400;opacity:.85;}
.bnr-info{padding:14px 18px 16px;}
.bnr-meta{display:flex;justify-content:space-between;align-items:center;}
.bnr-status{font-family:'Manrope';font-weight:800;font-size:11px;letter-spacing:.04em;}
.bnr-status.on{color:var(--positive);}
.bnr-status.off{color:var(--ink-3);}
.bnr-dates{font-family:'Manrope';font-weight:600;font-size:11.5px;color:var(--ink-3);}
.bnr-stats{margin-top:12px;padding:10px 14px;background:var(--bg-soft);border-radius:var(--r-md);display:flex;justify-content:space-between;gap:8px;}
.bnr-stats div{flex:1;text-align:center;font-family:'Manrope';font-size:10.5px;color:var(--ink-3);font-weight:600;}
.bnr-stats strong{display:block;font-family:'Fraunces',serif;font-weight:700;font-size:16px;color:var(--ink);margin-bottom:2px;letter-spacing:-.01em;}
.bnr-actions{margin-top:12px;display:flex;gap:8px;}
.bnr-btn{flex:1;padding:10px 12px;border-radius:var(--r-pill);font-family:'Manrope';font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;gap:6px;}
.bnr-btn.edit{background:var(--gold-wash);color:var(--gold-deep);}
.bnr-btn.pause{background:var(--bg-deep);color:var(--ink-2);}
.bnr-btn.play{background:var(--positive-soft);color:var(--positive);}
.bnr-btn.del{flex:0 0 44px;background:var(--negative-soft);color:var(--negative);}

/* Admin sub-filter tabs */
.adt-filter{padding:8px 14px;border-radius:var(--r-pill);background:var(--surface);color:var(--ink-2);font-family:'Manrope';font-weight:700;font-size:12px;display:flex;align-items:center;gap:7px;box-shadow:var(--shadow-sm);border:1px solid var(--bg-deep);}
.adt-filter.on{background:var(--espresso);color:var(--gold);border-color:transparent;}
.adt-filter .c{padding:1px 7px;border-radius:999px;background:var(--bg-deep);color:var(--ink-2);font-size:10.5px;font-weight:800;}
.adt-filter.on .c{background:rgba(201,160,99,.22);color:var(--gold);}

/* Request / report cards */
.req-card,.rapor-card{margin:10px 20px 0;background:var(--surface);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);overflow:hidden;}
.rapor-card.critical{border:1.5px solid rgba(180,66,47,.25);box-shadow:0 6px 20px rgba(180,66,47,.08);}

.req-head,.rapor-head{padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid var(--bg-deep);}
.req-user{display:flex;align-items:center;gap:12px;min-width:0;flex:1;}
.ru-av{width:40px;height:40px;border-radius:12px;background:var(--gold);color:var(--espresso);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:800;font-size:16px;flex-shrink:0;}
.ru-tx{min-width:0;}
.ru-nm{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);display:flex;align-items:center;gap:6px;}
.ru-nm .tier{font-family:'Manrope';font-weight:800;font-size:9.5px;letter-spacing:.08em;color:var(--gold-deep);background:var(--gold-wash);padding:2px 6px;border-radius:4px;}
.ru-time{font-family:'Manrope';font-size:11px;color:var(--ink-3);margin-top:2px;}

.req-stat{padding:5px 10px;border-radius:var(--r-pill);font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.04em;white-space:nowrap;}
.req-stat.wait{background:var(--gold-wash);color:var(--gold-deep);}
.req-stat.ok{background:var(--positive-soft);color:var(--positive);}
.req-stat.no{background:var(--negative-soft);color:var(--negative);}

.req-body{padding:14px 16px;}
.req-row{display:flex;gap:10px;padding:6px 0;}
.req-row + .req-row{border-top:1px dashed var(--bg-deep);}
.req-k{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);width:82px;flex-shrink:0;padding-top:2px;}
.req-v{font-family:'Manrope';font-weight:600;font-size:13px;color:var(--ink);flex:1;line-height:1.45;}

.req-actions,.rapor-actions{padding:12px 16px 14px;display:flex;gap:8px;border-top:1px solid var(--bg-deep);}
.req-btn{flex:1;padding:11px 12px;border-radius:var(--r-pill);font-family:'Manrope';font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;gap:6px;}
.req-btn.approve{background:var(--positive-soft);color:var(--positive);}
.req-btn.reject{flex:0 0 auto;padding:11px 18px;background:var(--negative-soft);color:var(--negative);}

/* Report card */
.rapor-product{display:flex;align-items:center;gap:12px;min-width:0;flex:1;}
.rp-thumb{width:44px;height:44px;border-radius:12px;background:var(--bg-deep);color:var(--ink-2);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.rp-tx{min-width:0;}
.rp-nm{font-family:'Manrope';font-weight:700;font-size:14px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.rp-sub{font-family:'Manrope';font-size:11.5px;color:var(--ink-3);margin-top:2px;}

.rapor-count{text-align:center;padding:6px 14px;border-radius:var(--r-lg);background:var(--negative-soft);color:var(--negative);}
.rapor-card:not(.critical) .rapor-count{background:var(--gold-wash);color:var(--gold-deep);}
.rc-num{font-family:'Fraunces',serif;font-weight:800;font-size:22px;line-height:1;letter-spacing:-.02em;}
.rc-lbl{font-family:'Manrope';font-weight:700;font-size:9px;letter-spacing:.14em;text-transform:uppercase;margin-top:2px;}

.rapor-alert{margin:12px 16px 0;padding:10px 14px;background:var(--negative-soft);color:var(--negative);border-radius:var(--r-md);display:flex;align-items:center;gap:10px;font-family:'Manrope';font-weight:700;font-size:11.5px;line-height:1.4;}
.rapor-alert i{font-size:14px;flex-shrink:0;}

.rapor-list{padding:8px 16px 4px;}
.rl-item{padding:10px 0;display:flex;gap:12px;}
.rl-item + .rl-item{border-top:1px dashed var(--bg-deep);}
.rl-av{width:30px;height:30px;border-radius:10px;background:var(--bg-deep);color:var(--ink-2);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:800;font-size:13px;flex-shrink:0;}
.rl-bd{flex:1;min-width:0;}
.rl-top{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.rl-nm{font-family:'Manrope';font-weight:700;font-size:13px;color:var(--ink);}
.rl-tg{font-family:'Manrope';font-weight:800;font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:var(--r-pill);background:var(--negative-soft);color:var(--negative);}
.rl-desc{font-family:'Manrope';font-size:12px;color:var(--ink-2);margin-top:4px;line-height:1.5;}
.rl-time{font-family:'Manrope';font-size:10.5px;color:var(--ink-4);margin-top:4px;}

/* ============================================================
   MAP / Location page
   ============================================================ */
#konum{background:var(--bg);}
.map-surface{margin:14px 20px 0;height:260px;border-radius:var(--r-2xl);background:linear-gradient(135deg,#E4DFD6 0%,#D8D2C6 100%);position:relative;overflow:hidden;box-shadow:var(--shadow-md);}
.map-surface::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(122,106,90,.15) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122,106,90,.15) 1px, transparent 1px),
    radial-gradient(circle at 30% 40%, rgba(201,160,99,.14), transparent 40%),
    radial-gradient(circle at 70% 70%, rgba(122,106,90,.1), transparent 50%);
  background-size: 32px 32px, 32px 32px, 100% 100%, 100% 100%;
}
.pin{position:absolute;width:32px;height:32px;border-radius:50% 50% 50% 0;background:var(--espresso);transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 14px rgba(26,17,10,.35);}
.pin i{transform:rotate(45deg);color:var(--gold);font-size:12px;}
.pin.you{background:var(--gold);box-shadow:0 6px 14px rgba(201,160,99,.4);}
.pin.you i{color:var(--espresso);}
.pin.p1{top:24%;left:22%;}
.pin.p2{top:60%;left:62%;}
.pin.p3{top:38%;left:74%;}
.pin.p4{top:72%;left:28%;}
.pin.you{top:48%;left:44%;}

/* ============================================================
   TOAST
   ============================================================ */
.toast-wrap{position:absolute;left:20px;right:20px;top:70px;display:flex;flex-direction:column;gap:8px;z-index:999;pointer-events:none;}
.toast{padding:14px 18px;background:var(--espresso);color:var(--gold);border-radius:var(--r-lg);font-family:'Manrope';font-weight:700;font-size:13px;box-shadow:var(--shadow-lg);display:flex;align-items:center;gap:10px;animation:toastIn .25s ease, toastOut .25s ease 2.2s both;}
.toast i{color:var(--gold);}
@keyframes toastIn{from{opacity:0;transform:translateY(-12px);}to{opacity:1;transform:translateY(0);}}
@keyframes toastOut{to{opacity:0;transform:translateY(-12px);}}

/* Spinner */
.spin{width:32px;height:32px;border-radius:50%;border:3px solid rgba(201,160,99,.2);border-top-color:var(--gold);animation:spin .8s linear infinite;}

/* Bottom Sheet Modal */
.sheet-mask{position:absolute;inset:0;background:rgba(26,17,10,.5);backdrop-filter:blur(6px);z-index:500;opacity:0;pointer-events:none;transition:opacity .25s ease;}
.sheet-mask.on{opacity:1;pointer-events:auto;}
.sheet{position:absolute;left:0;right:0;bottom:0;background:var(--surface);border-radius:30px 30px 0 0;padding:10px 22px 28px;z-index:501;transform:translateY(100%);transition:transform .35s cubic-bezier(.34,1.2,.3,1);max-height:80%;overflow-y:auto;box-shadow:0 -20px 60px rgba(26,17,10,.25);}
.sheet.on{transform:translateY(0);}
.sheet-handle{width:44px;height:5px;border-radius:999px;background:var(--bg-deep);margin:0 auto 18px;}
.sheet-head{margin-bottom:18px;}
.sheet-head .sh-over{font-family:'Manrope';font-weight:800;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-deep);margin-bottom:6px;}
.sheet-head h2{font-family:'Fraunces',serif;font-weight:700;font-size:26px;letter-spacing:-.02em;line-height:1.1;margin:0;color:var(--ink);}
.sheet-head h2 em{font-style:italic;font-weight:400;color:var(--ink-3);}
.sheet-head .desc{margin-top:8px;font-family:'Manrope';font-size:13px;color:var(--ink-3);line-height:1.55;}
.sheet-field{margin-top:14px;}
.sheet-field label{display:block;font-family:'Manrope';font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);margin-bottom:8px;}
.sheet-field .input-grp{background:var(--bg-soft);box-shadow:none;border:1px solid var(--bg-deep);}
.sheet-field textarea{width:100%;min-height:90px;resize:none;border:1px solid var(--bg-deep);outline:0;background:var(--bg-soft);font-family:'Manrope';font-weight:500;font-size:14px;color:var(--ink);line-height:1.5;padding:14px 16px;border-radius:var(--r-lg);}
.sheet-field textarea:focus{border-color:var(--gold);}
.sheet-field textarea::placeholder{color:var(--ink-4);}

.reason-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:2px;}
.reason{padding:14px 12px;border:1.5px solid var(--bg-deep);border-radius:var(--r-lg);background:var(--bg-soft);font-family:'Manrope';font-weight:700;font-size:12.5px;color:var(--ink);display:flex;flex-direction:column;gap:6px;align-items:flex-start;text-align:left;transition:all .15s ease;}
.reason i{color:var(--gold-deep);font-size:16px;}
.reason.on{border-color:var(--gold);background:var(--gold-wash);}
.reason.on i{color:var(--gold-deep);}
.reason .r-title{font-weight:800;}
.reason .r-desc{font-family:'Manrope';font-weight:500;font-size:10.5px;color:var(--ink-3);}
.reason.on .r-desc{color:var(--gold-deep);}

.sheet-cta{margin-top:22px;width:100%;padding:16px;border-radius:var(--r-pill);background:linear-gradient(135deg,#C9A063 0%,#A57E46 100%);color:var(--espresso);font-family:'Manrope';font-weight:800;font-size:14.5px;letter-spacing:.02em;box-shadow:var(--shadow-gold);display:flex;align-items:center;justify-content:center;gap:10px;}
.sheet-cta.danger{background:linear-gradient(135deg,#C74A36 0%,#9b3825 100%);color:#fff;box-shadow:0 10px 26px rgba(180,66,47,.3);}
.sheet-cancel{margin-top:10px;width:100%;padding:14px;border-radius:var(--r-pill);background:var(--bg-soft);color:var(--ink-2);font-family:'Manrope';font-weight:700;font-size:13px;}
@keyframes spin{to{transform:rotate(360deg);}}

</style>
</head>
