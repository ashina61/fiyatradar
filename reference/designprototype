<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FiyatRadar V10 — Complete Prototype</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #1A1614;
            --bg-secondary: #24201D;
            --surface: #2A2522;
            --surface-alt: #312C29;
            --border: rgba(61, 54, 51, 0.4);
            --text-primary: rgba(250, 246, 242, 0.96);
            --text-secondary: rgba(210, 200, 190, 0.68);
            --text-subtle: rgba(201, 191, 184, 0.42);
            --tan: #C4A57B;
            --success: #8A9A8B;
            --success-bg: rgba(138, 154, 139, 0.1);
            --radius-md: 10px;
            --radius-lg: 14px;
            --radius-xl: 18px;
            --radius-full: 9999px;
            --shadow-md: 0 2px 6px rgba(0,0,0,0.18);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #E8E4DF 0%, #D4CFC7 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .phone-frame {
            width: 390px;
            height: 844px;
            background: var(--bg-primary);
            border-radius: 56px;
            box-shadow: 0 0 0 14px #12100E, 0 25px 100px rgba(0,0,0,0.5);
            overflow: hidden;
            position: relative;
            transform: scale(0.92);
        }

        .screen {
            display: none;
            flex-direction: column;
            height: 100%;
        }

        .screen.active { display: flex; }

        .status-bar {
            height: 44px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 24px;
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 600;
            flex-shrink: 0;
        }

        .app-bar {
            padding: 16px 24px;
            background: var(--bg-primary);
            flex-shrink: 0;
        }

        .app-bar-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .app-bar-title span { color: var(--tan); }

        .screen-content {
            flex: 1;
            overflow-y: auto;
        }

        .search-input-wrapper {
            margin: 0 24px 16px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .search-input {
            flex: 1;
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 15px;
            outline: none;
        }

        .section { padding: 0 24px 24px; }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .section-title i { color: var(--tan); }

        .live-feed-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 14px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .product-image {
            width: 50px;
            height: 50px;
            background: var(--surface-alt);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: var(--tan);
        }

        .product-info { flex: 1; }

        .product-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .product-meta {
            font-size: 10px;
            color: var(--text-subtle);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .product-price {
            font-size: 16px;
            font-weight: 700;
            color: var(--tan);
        }

        .trend-scroll {
            display: flex;
            gap: 13px;
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .trend-card {
            flex-shrink: 0;
            width: 155px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid var(--border);
        }

        .trend-image {
            height: 105px;
            background: var(--surface-alt);
            border-radius: var(--radius-xl) var(--radius-xl) 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 42px;
            color: var(--tan);
        }

        .trend-content { padding: 11px; }

        .trend-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 3px;
        }

        .trend-price {
            font-size: 10px;
            color: var(--text-subtle);
        }

        .fab {
            position: absolute;
            bottom: 90px;
            right: 20px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--tan);
            color: var(--bg-primary);
            border: none;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(196, 165, 123, 0.3);
        }

        .bottom-nav {
            height: 72px;
            background: rgba(42, 37, 34, 0.97);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-shrink: 0;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: var(--text-subtle);
            cursor: pointer;
        }

        .nav-item.active { color: var(--tan); }

        .nav-icon { font-size: 20px; }

        .nav-label { font-size: 10px; font-weight: 600; }

        /* Cart Screen Specific */
        .summary-card {
            margin: 16px;
            padding: 18px;
            background: linear-gradient(135deg, rgba(196, 165, 123, 0.08), rgba(196, 165, 123, 0.02));
            border-radius: var(--radius-xl);
            border: 1px solid rgba(196, 165, 123, 0.25);
            text-align: center;
        }

        .summary-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-subtle);
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .summary-total {
            font-size: 36px;
            font-weight: 900;
            color: var(--text-primary);
            letter-spacing: -1px;
        }

        .savings-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--success-bg);
            color: var(--success);
            padding: 6px 12px;
            border-radius: var(--radius-full);
            border: 1px solid rgba(138, 154, 139, 0.3);
            margin-top: 12px;
            font-size: 12px;
            font-weight: 700;
        }

        .toggle-container {
            margin: 0 16px 16px;
            padding: 4px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            display: flex;
        }

        .toggle-option {
            flex: 1;
            padding: 10px;
            text-align: center;
            border-radius: var(--radius-md);
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .toggle-option.active {
            background: var(--tan);
            color: var(--bg-primary);
        }

        .cart-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            margin: 0 16px 10px;
        }

        .cart-item-header {
            padding: 14px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .cart-item-platform {
            padding: 10px 14px;
            background: var(--surface-alt);
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .platform-logo {
            width: 24px;
            height: 24px;
            background: var(--tan);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            color: var(--bg-primary);
        }

        .trust-badge {
            padding: 3px 6px;
            background: var(--success-bg);
            border-radius: var(--radius-sm);
            border: 1px solid rgba(138, 154, 139, 0.3);
            font-size: 10px;
            font-weight: 700;
            color: var(--success);
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .action-bar {
            padding: 12px 16px 18px;
            background: linear-gradient(180deg, transparent, rgba(26, 22, 20, 0.95));
        }

        .btn-primary {
            width: 100%;
            height: 52px;
            background: var(--tan);
            color: var(--bg-primary);
            border: none;
            border-radius: var(--radius-lg);
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 10px;
        }

        .btn-secondary {
            width: 100%;
            height: 48px;
            background: transparent;
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .microcopy {
            text-align: center;
            font-size: 10px;
            color: var(--text-subtle);
            margin-top: 10px;
            line-height: 1.45;
        }

        /* Navigation Helpers */
        .nav-helpers {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 1000;
        }

        .nav-helper-btn {
            background: rgba(26, 26, 23, 0.95);
            border: 2px solid var(--tan);
            border-radius: var(--radius-lg);
            padding: 8px 16px;
            color: var(--tan);
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .nav-helper-btn:hover {
            background: var(--tan);
            color: var(--bg-primary);
        }
    </style>
</head>
<body>

<div class="phone-frame">
