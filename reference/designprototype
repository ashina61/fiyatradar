  const cur = document.querySelector('.page.active');
  const next = document.getElementById(id);
  if (!next) return;
  if (cur) cur.classList.remove('active');
  next.classList.add('active');
  // scroll to top
  next.scrollTop = 0;
  window.scrollTo(0,0);
  // dark-mode sync for bottom nav
  const device = document.getElementById('device');
  if (next.classList.contains('dark-page')) device.classList.add('on-dark');
  else device.classList.remove('on-dark');
  // nav sync
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('on'));
  const navMatch = document.querySelector(`.nav-item[data-nav="${id}"]`);
  if (navMatch) navMatch.classList.add('on');
  // stack
  if (mainPages.includes(id)){
    pageStack = [id];
  } else {
    pageStack.push(id);
  }
}
function goBack(){
  if (pageStack.length > 1){
    pageStack.pop();
    const prev = pageStack[pageStack.length-1];
    const cur = document.querySelector('.page.active');
    const next = document.getElementById(prev);
    if (cur) cur.classList.remove('active');
    if (next) next.classList.add('active');
    const device = document.getElementById('device');
    if (next && next.classList.contains('dark-page')) device.classList.add('on-dark');
    else device.classList.remove('on-dark');
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('on'));
    const navMatch = document.querySelector(`.nav-item[data-nav="${prev}"]`);
    if (navMatch) navMatch.classList.add('on');
  } else {
    goPage('home');
  }
}
function goDetay(){ goPage('detay'); }

