/* ===== Bottom sheet modals ===== */
function openSheet(key){
  document.getElementById('msk'+capitalize(key)).classList.add('on');
  document.getElementById('sh'+capitalize(key)).classList.add('on');
}
function closeSheet(key){
  document.getElementById('msk'+capitalize(key)).classList.remove('on');
  document.getElementById('sh'+capitalize(key)).classList.remove('on');
}
function capitalize(s){return s.charAt(0).toUpperCase()+s.slice(1);}

function openUrunTalep(){openSheet('urun');}
