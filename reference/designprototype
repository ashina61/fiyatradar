                    <div class="admin-form-group"><label class="admin-form-label">Mesaj</label><textarea class="admin-form-input" id="notif-message" rows="3" placeholder="Bildirim mesajı"></textarea></div>
                    <div class="admin-form-group"><label class="admin-form-label">Hedef</label><select class="admin-form-input" id="notif-target"><option value="all">Tüm Kullanıcılar</option><option value="active">Aktif Kullanıcılar</option></select></div>
                    <button class="admin-btn admin-btn-primary" onclick="sendNotification()"><i class="fas fa-paper-plane"></i> Bildirim Gönder</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"><i class="fas fa-check-circle"></i><span id="toast-msg">Message</span></div>

<script>
    // Data Store
    let products = [
        { id: 1, name: 'Bluetooth Hoparlör', icon: '📻', category: 'elektronik', prices: { 'Trendyol': 899, 'Amazon': 949, 'Hepsiburada': 929 }, change: -5, time: '1 dk', user: 'Ahmet K.' },
        { id: 2, name: 'Protein Tozu', icon: '💪', category: 'gida', prices: { 'Trendyol': 749, 'Amazon': 799, 'Hepsiburada': 769 }, change: -12, time: '4 dk', user: 'Mehmet Y.' },
        { id: 3, name: 'Airfryer', icon: '🍳', category: 'ev', prices: { 'Trendyol': 2599, 'Amazon': 2699, 'Hepsiburada': 2649 }, change: -8, time: '10 dk', user: 'Ayşe T.' },
        { id: 4, name: 'Kablosuz Kulaklık', icon: '🎧', category: 'elektronik', prices: { 'Trendyol': 1299, 'Amazon': 1349, 'Hepsiburada': 1399 }, change: -15, time: '2 dk', user: 'Fatih K.' },
        { id: 5, name: 'Şampuan Pro', icon: '💧', category: 'bakim', prices: { 'Trendyol': 189, 'Amazon': 199, 'Hepsiburada': 195 }, change: 3, time: '5 dk', user: 'Zeynep A.' },
        { id: 6, name: 'Kahve Çekirdeği', icon: '☕', category: 'gida', prices: { 'Trendyol': 329, 'Amazon': 349, 'Hepsiburada': 339 }, change: -7, time: '12 dk', user: 'Can B.' }
    ];

    let categories = [
        { id: 'all', name: 'Tümü', icon: 'fas fa-th' },
        { id: 'elektronik', name: 'Elektronik', icon: 'fas fa-laptop' },
        { id: 'gida', name: 'Gıda', icon: 'fas fa-utensils' },
        { id: 'bakim', name: 'Bakım', icon: 'fas fa-spa' },
        { id: 'ev', name: 'Ev', icon: 'fas fa-home' },
        { id: 'spor', name: 'Spor', icon: 'fas fa-dumbbell' }
    ];

    let banners = [
        { id: 1, title: 'Haftanın Fırsatları', desc: 'En çok düşen fiyatları keşfet', tag: '🔥 Fırsat', color: 'linear-gradient(135deg, #8B6914, #B8956A)' },
        { id: 2, title: 'Doğrulanmış Düşüşler', desc: 'Topluluk tarafından onaylananlar', tag: '✅ Güvenilir', color: 'linear-gradient(135deg, #4A6B5A, #6B8A7A)' },
        { id: 3, title: 'Popüler Ürünler', desc: 'Bu hafta en çok arananlar', tag: '⭐ Popüler', color: 'linear-gradient(135deg, #6B4A8A, #8A6BAA)' }
    ];

    let favorites = new Set();
    let currentFilter = 'all';
    let currentBanner = 0;

    // Navigation
    function showScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.admin-screen').forEach(s => s.classList.remove('active'));
        if (screenId === 'admin-panel') {
            document.getElementById('admin-panel').classList.add('active');
            renderAdminDashboard();
            renderAdminProducts();
            renderAdminBanners();
            renderAdminCategories();
        } else {
            document.getElementById(screenId).classList.add('active');
        }
        const navMap = { 'home-screen': 0, 'search-screen': 1, 'add-price-screen': 2, 'cart-screen': 3, 'profile-screen': 4 };
        document.querySelectorAll('.bottom-nav').forEach(nav => {
            nav.querySelectorAll('.nav-item').forEach((item, i) => {
                item.classList.toggle('active', navMap[screenId] === i);
            });
        });
        if (screenId === 'home-screen') renderHomeProducts();
        if (screenId === 'search-screen') renderSearchResults(products);
    }

    function showToast(msg) {
        const toast = document.getElementById('toast');
        document.getElementById('toast-msg').innerText = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    function showNotifications() { document.getElementById('notif-panel').classList.add('active'); }
    function hideNotifications() { document.getElementById('notif-panel').classList.remove('active'); }

    function toggleFavorite(productId, event) {
        if (event) event.stopPropagation();
        if (favorites.has(productId)) { favorites.delete(productId); showToast('Favorilerden çıkarıldı'); }
        else { favorites.add(productId); showToast('Favorilere eklendi ❤️'); }
        renderHomeProducts();
    }

    function goToBanner(index) {
        currentBanner = index;
        document.getElementById('banner-carousel').scrollLeft = index * 350;
        document.querySelectorAll('.banner-dot').forEach((dot, i) => dot.classList.toggle('active', i === index));
    }

    setInterval(() => { currentBanner = (currentBanner + 1) % banners.length; goToBanner(currentBanner); }, 5000);

    // Timer
    function updateTimer() {
        const now = new Date();
        const end = new Date(now); end.setHours(23, 59, 59, 999);
        const diff = end - now;
        document.getElementById('timer-hours').innerText = String(Math.floor(diff / 3600000)).padStart(2, '0');
        document.getElementById('timer-minutes').innerText = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
        document.getElementById('timer-seconds').innerText = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
    }
    setInterval(updateTimer, 1000); updateTimer();

    // Price Drop Alert
    setTimeout(() => { document.getElementById('price-drop-alert').classList.add('show'); setTimeout(() => document.getElementById('price-drop-alert').classList.remove('show'), 5000); }, 3000);

    // Category Filter
    function filterByCategory(element, category) {
        document.querySelectorAll('.category-chip').forEach(c => c.classList.remove('active'));
        element.classList.add('active');
        currentFilter = category;
        renderHomeProducts();
    }

    // Render Products
    function renderHomeProducts() {
        const container = document.getElementById('home-products');
        let filtered = currentFilter === 'all' ? products : products.filter(p => p.category === currentFilter);
        container.innerHTML = filtered.map(p => {
            const minPrice = Math.min(...Object.values(p.prices));
            const bestPlatform = Object.keys(p.prices).find(k => p.prices[k] === minPrice);
            return `<div class="product-card" onclick="showScreen('detail-screen')">
                <div class="card-image"><span>${p.icon}</span>
                    <button class="card-favorite ${favorites.has(p.id) ? 'active' : ''}" onclick="toggleFavorite(${p.id}, event)"><i class="fas fa-heart"></i></button>
                    <div class="card-change-badge ${p.change < 0 ? 'down' : 'up'}"><i class="fas fa-arrow-${p.change < 0 ? 'down' : 'up'}"></i> ${Math.abs(p.change)}%</div>
                </div>
                <div class="card-content">
                    <div class="card-name">${p.name}</div>
                    <div class="card-price">${minPrice.toLocaleString('tr-TR')}<span class="currency">TL</span></div>
                    <div class="card-meta">
                        <div class="card-meta-row"><i class="fas fa-store"></i><span>${bestPlatform}</span></div>
                        <div class="card-meta-row"><i class="fas fa-user"></i><span class="user">${p.user}</span><span>• ${p.time} önce</span></div>
                    </div>
                </div>
            </div>`;
        }).join('');
    }

    // Search
    function filterProducts() {
        const query = document.getElementById('search-input').value.toLowerCase();
        document.getElementById('clear-search').style.display = query ? 'block' : 'none';
        let filtered = products;
        if (query) filtered = products.filter(p => p.name.toLowerCase().includes(query) || p.category.includes(query));
        renderSearchResults(filtered);
    }

    function clearSearch() { document.getElementById('search-input').value = ''; document.getElementById('clear-search').style.display = 'none'; filterProducts(); }

    function setFilter(element, category) {
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        element.classList.add('active');
        currentFilter = category;
        filterProducts();
    }

    function renderSearchResults(filteredProducts) {
        const container = document.getElementById('search-results');
        document.getElementById('result-count').innerText = filteredProducts.length;
        if (filteredProducts.length === 0) {
            container.innerHTML = '<div style="padding: 40px 24px; text-align: center;"><i class="fas fa-search" style="font-size: 48px; color: var(--text-subtle); margin-bottom: 16px;"></i><div style="font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px;">Sonuç bulunamadı</div></div>';
            return;
        }
        container.innerHTML = filteredProducts.map(p => {
            const minPrice = Math.min(...Object.values(p.prices));
            return `<div class="live-feed-item" onclick="showScreen('detail-screen')">
                <div style="width: 50px; height: 50px; background: linear-gradient(135deg, var(--surface-alt), var(--surface-elevated)); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">${p.icon}</div>
                <div style="flex: 1;"><div style="font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">${p.name}</div><div style="font-size: 10px; color: var(--text-subtle);">${Object.keys(p.prices).find(k => p.prices[k] === minPrice)} • ${p.time} önce</div></div>
                <div style="font-size: 16px; font-weight: 700; color: var(--tan);">${minPrice.toLocaleString('tr-TR')} TL</div>
            </div>`;
        }).join('');
    }

    // Admin Functions
    function switchAdminTab(element, tabId) {
        document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
        element.classList.add('active');
        document.getElementById('admin-' + tabId).classList.add('active');
    }

    function renderAdminDashboard() {
        document.getElementById('stat-products').innerText = products.length;
        document.getElementById('admin-dashboard-table').innerHTML = products.slice(0, 4).map(p => {
            const minPrice = Math.min(...Object.values(p.prices));
            return `<div class="admin-table-row"><div class="table-product"><div class="table-icon">${p.icon}</div><div class="table-name">${p.name}</div></div><div class="table-price">${minPrice.toLocaleString('tr-TR')} TL</div><div class="table-category">${p.category}</div><div><span class="table-status active">Aktif</span></div><div class="table-actions"><div class="table-action-btn"><i class="fas fa-edit"></i></div></div></div>`;
        }).join('');
    }

    function renderAdminProducts() {
        document.getElementById('admin-products-table').innerHTML = products.map(p => {
            const minPrice = Math.min(...Object.values(p.prices));
            return `<div class="admin-table-row"><div class="table-product"><div class="table-icon">${p.icon}</div><div class="table-name">${p.name}</div></div><div class="table-price">${minPrice.toLocaleString('tr-TR')} TL</div><div class="table-category">${p.category}</div><div><span class="table-status active">Aktif</span></div><div class="table-actions"><div class="table-action-btn" onclick="deleteProduct(${p.id})"><i class="fas fa-trash"></i></div></div></div>`;
        }).join('');
    }

    function renderAdminBanners() {
        document.getElementById('admin-banners-list').innerHTML = banners.map(b => `
            <div class="banner-admin-item">
                <div class="banner-admin-preview" style="background: ${b.color};">${b.tag.split(' ')[0]}</div>
                <div class="banner-admin-info"><div class="banner-admin-title">${b.title}</div><div class="banner-admin-desc">${b.desc}</div></div>
                <div class="banner-admin-actions"><div class="table-action-btn" onclick="deleteBanner(${b.id})"><i class="fas fa-trash"></i></div></div>
            </div>`).join('');
    }

    function renderAdminCategories() {
        document.getElementById('admin-categories-list').innerHTML = categories.filter(c => c.id !== 'all').map(c => `
            <div class="banner-admin-item">
                <div class="banner-admin-preview" style="background: var(--surface-alt); display: flex; align-items: center; justify-content: center;"><i class="${c.icon}" style="font-size: 20px; color: var(--tan);"></i></div>
                <div class="banner-admin-info"><div class="banner-admin-title">${c.name}</div><div class="banner-admin-desc">${products.filter(p => p.category === c.id).length} ürün</div></div>
                <div class="banner-admin-actions"><div class="table-action-btn" onclick="deleteCategory('${c.id}')"><i class="fas fa-trash"></i></div></div>
            </div>`).join('');
    }

    function showAddProductForm() { document.getElementById('add-product-form').style.display = 'block'; }
    function hideAddProductForm() { document.getElementById('add-product-form').style.display = 'none'; }

    function addNewProduct() {
        const name = document.getElementById('new-product-name').value;
        const price = document.getElementById('new-product-price').value;
        const category = document.getElementById('new-product-category').value;
        const icon = document.getElementById('new-product-icon').value || '📦';
        if (!name || !price) { showToast('❌ Lütfen tüm alanları doldurun'); return; }
        products.push({ id: Date.now(), name, icon, category, prices: { 'Trendyol': parseInt(price) }, change: 0, time: 'Şimdi', user: 'Admin' });
        hideAddProductForm();
        renderAdminProducts(); renderAdminDashboard(); renderHomeProducts();
        showToast('✅ Ürün eklendi!');
        document.getElementById('new-product-name').value = ''; document.getElementById('new-product-price').value = ''; document.getElementById('new-product-icon').value = '';
    }

    function deleteProduct(id) { products = products.filter(p => p.id !== id); renderAdminProducts(); renderAdminDashboard(); renderHomeProducts(); showToast('🗑️ Ürün silindi'); }

    function showAddBannerForm() { document.getElementById('add-banner-form').style.display = 'block'; }
    function hideAddBannerForm() { document.getElementById('add-banner-form').style.display = 'none'; }

    function addNewBanner() {
        const title = document.getElementById('new-banner-title').value;
        const desc = document.getElementById('new-banner-desc').value;
        const color = document.getElementById('new-banner-color').value;
        const tag = document.getElementById('new-banner-tag').value || '🔥 Yeni';
        if (!title) { showToast('❌ Lütfen başlık girin'); return; }
        banners.push({ id: Date.now(), title, desc, color, tag });
        hideAddBannerForm(); renderAdminBanners(); showToast('✅ Banner eklendi!');
        document.getElementById('new-banner-title').value = ''; document.getElementById('new-banner-desc').value = ''; document.getElementById('new-banner-tag').value = '';
    }

    function deleteBanner(id) { banners = banners.filter(b => b.id !== id); renderAdminBanners(); showToast('🗑️ Banner silindi'); }

    function showAddCategoryForm() { document.getElementById('add-category-form').style.display = 'block'; }
    function hideAddCategoryForm() { document.getElementById('add-category-form').style.display = 'none'; }

    function addNewCategory() {
        const name = document.getElementById('new-category-name').value;
        const icon = document.getElementById('new-category-icon').value || 'fas fa-tag';
        if (!name) { showToast('❌ Lütfen kategori adı girin'); return; }
        const id = name.toLowerCase().replace(/\s+/g, '-');
        categories.push({ id, name, icon });
        hideAddCategoryForm(); renderAdminCategories(); showToast('✅ Kategori eklendi!');
        document.getElementById('new-category-name').value = ''; document.getElementById('new-category-icon').value = '';
    }

    function deleteCategory(id) { categories = categories.filter(c => c.id !== id); renderAdminCategories(); showToast('🗑️ Kategori silindi'); }

    function sendNotification() {
        const title = document.getElementById('notif-title').value;
        const message = document.getElementById('notif-message').value;
        if (!title || !message) { showToast('❌ Lütfen tüm alanları doldurun'); return; }
        const badge = document.getElementById('notif-badge');
        badge.innerText = parseInt(badge.innerText) + 1;
        showToast('📤 Bildirim gönderildi!');
        document.getElementById('notif-title').value = ''; document.getElementById('notif-message').value = '';
    }

    // Init
    document.addEventListener('DOMContentLoaded', () => { renderHomeProducts(); renderSearchResults(products); });
</script>

</body>
</html>

