}

/* Category chip toggle on home */
document.querySelectorAll('.cat-rail').forEach(rail=>{
  rail.addEventListener('click',e=>{
    const btn = e.target.closest('.cat');
    if (!btn) return;
    rail.querySelectorAll('.cat').forEach(c=>c.classList.remove('on'));
    btn.classList.add('on');
  });
});

/* Ekle store chips */
document.querySelectorAll('.chips-row').forEach(row=>{
  row.addEventListener('click',e=>{
    const b = e.target.closest('.ch');
    if (!b) return;
    row.querySelectorAll('.ch').forEach(c=>c.classList.remove('on'));
    b.classList.add('on');
  });
});
