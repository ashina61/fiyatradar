<?xml version="1.0" encoding="utf-8"?>
<!-- Light-mode native splash. We keep the brand background only (no logo)
     so the user sees a single FR mark — rendered by Flutter's _SplashScreen
     once the engine boots — instead of two splashes flashing back-to-back. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fr_splash_bg"/>
</layer-list>
