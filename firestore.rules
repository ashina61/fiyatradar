rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function hasNoImmutableUserChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isAdmin',
        'isBanned',
        'banReason',
        'role',
        'email',
        // Premium durumu istemcide DEĞİŞTİRİLEMEZ. Cloud Function
        // (in_app_purchase webhook + restore akışı) admin SDK ile yazar;
        // istemci sadece okur ve UI'da kapı/açık gösterir.
        'isPremium',
        'premiumUntil',
        'premiumPlan',
        'premiumProductId',
        'priceEntries',
        'validations',
        'inviteCount',
        'reliabilityScore',
        'reliabilityVotesTotal',
        'reliabilityVotesUp',
        'reliabilityVotesDown',
        'trustScorePercent',
        'inviteCode',
        'invitedBy',
        'createdAt'
      ]);
    }

    function hasOnlyUserWritableKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'firstName',
        'lastName',
        'photoUrl',
        'profileImageUrl',
        'profileImagePath',
        'avatarUrl',
        'displayName',
        'username',
        'phoneNumber',
        'cityCode',
        'cityName',
        'city',
        'district',
        'neighborhood',
        'savedProducts',
        'favorites',
        'cart',
        'homeScope',
        'notificationPrefs',
        'settings',
        'alarmNotifications',
        'campaignNotifications',
        'badgeNotifications',
        'fcmToken',
        'lastLoginAt',
        'lastCheckoutAt',
        'updatedAt',
        // Points / trust / contributions counters — managed client-side via
        // transactions. Rules cap the per-call delta below
        // (hasSafeUserGamificationMutation).
        'points',
        'trustTotalVotes',
        'trustVerifiedTotal',
        'trustWrongTotal',
        'contributions',
        // Streak / badge / per-kind contribution counters.
        'verifyContributions',
        'photoContributions',
        'currentStreak',
        'longestStreak',
        'lastContributionDay',
        'badges'
      ]);
    }

    function hasSafeProfileImageMutation(uid) {
      return (!request.resource.data.diff(resource.data).changedKeys().hasAny(['profileImageUrl']) ||
          (request.resource.data.profileImageUrl is string &&
            request.resource.data.profileImageUrl.size() <= 2048)) &&
        (!request.resource.data.diff(resource.data).changedKeys().hasAny(['photoUrl']) ||
          (request.resource.data.photoUrl is string &&
            request.resource.data.photoUrl.size() <= 2048)) &&
        (!request.resource.data.diff(resource.data).changedKeys().hasAny(['profileImagePath']) ||
          (request.resource.data.profileImagePath is string &&
            request.resource.data.profileImagePath.matches('^user_profiles/' + uid + '/[^/]+\\.(jpg|png|webp)$'))) &&
        (!request.resource.data.diff(resource.data).changedKeys().hasAny(['avatarUrl']) ||
          (request.resource.data.avatarUrl is string &&
            request.resource.data.avatarUrl.size() <= 2048));
    }

    function hasSafeUserCreateDefaults() {
      return (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('points' in request.resource.data) || request.resource.data.points == 0) &&
        (!('trustScorePercent' in request.resource.data) || request.resource.data.trustScorePercent == 0) &&
        (!('trustTotalVotes' in request.resource.data) || request.resource.data.trustTotalVotes == 0) &&
        (!('trustVerifiedTotal' in request.resource.data) || request.resource.data.trustVerifiedTotal == 0) &&
        (!('trustWrongTotal' in request.resource.data) || request.resource.data.trustWrongTotal == 0) &&
        // Premium kapısı doğum anında açık olamaz; Cloud Function aktifleştirir.
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
        (!('premiumUntil' in request.resource.data) || request.resource.data.premiumUntil == null);
    }

    function hasSafeCommentCreateDefaults() {
      return (!('likes' in request.resource.data) || request.resource.data.likes == 0) &&
        (!('likedBy' in request.resource.data) || request.resource.data.likedBy.size() == 0);
    }

    function hasSafeCommentCreatePayload() {
      return request.resource.data.keys().hasOnly([
        'productId',
        'userId',
        'text',
        'likes',
        'likedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      ('productId' in request.resource.data) &&
      ('userId' in request.resource.data) &&
      ('text' in request.resource.data) &&
      (request.resource.data.productId is string) &&
      (request.resource.data.userId is string) &&
      (request.resource.data.text is string) &&
      (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) &&
      (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function hasOnlyCommentOwnerWritableKeys() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'text',
        'updatedAt'
      ]);
    }

    function intFieldOrMissing(data, field) {
      return !(field in data) || data[field] is int;
    }

    function intFieldOrZero(data, field) {
      return (field in data && data[field] is int) ? data[field] : 0;
    }

    function hasSafeUserGamificationMutation() {
      // Per-call delta caps:
      //   points          : <= +50  (single action: addProduct=25, addPrice=10, etc.)
      //   trust counters  : <= +1   (one vote at a time)
      //   contributions   : <= +1   (one report at a time)
      // Without these caps any signed-in user can self-set `points: 9_999_999`
      // in a single update — the leaderboard / trust UI would silently lie.
      return intFieldOrMissing(request.resource.data, 'points') &&
        intFieldOrMissing(request.resource.data, 'trustTotalVotes') &&
        intFieldOrMissing(request.resource.data, 'trustVerifiedTotal') &&
        intFieldOrMissing(request.resource.data, 'trustWrongTotal') &&
        intFieldOrMissing(request.resource.data, 'contributions') &&
        intFieldOrZero(request.resource.data, 'points') >= 0 &&
        intFieldOrZero(request.resource.data, 'points') >= intFieldOrZero(resource.data, 'points') &&
        intFieldOrZero(request.resource.data, 'points') <= intFieldOrZero(resource.data, 'points') + 50 &&
        intFieldOrZero(request.resource.data, 'trustTotalVotes') >= intFieldOrZero(resource.data, 'trustTotalVotes') &&
        intFieldOrZero(request.resource.data, 'trustTotalVotes') <= intFieldOrZero(resource.data, 'trustTotalVotes') + 1 &&
        intFieldOrZero(request.resource.data, 'trustVerifiedTotal') >= intFieldOrZero(resource.data, 'trustVerifiedTotal') &&
        intFieldOrZero(request.resource.data, 'trustVerifiedTotal') <= intFieldOrZero(resource.data, 'trustVerifiedTotal') + 1 &&
        intFieldOrZero(request.resource.data, 'trustWrongTotal') >= intFieldOrZero(resource.data, 'trustWrongTotal') &&
        intFieldOrZero(request.resource.data, 'trustWrongTotal') <= intFieldOrZero(resource.data, 'trustWrongTotal') + 1 &&
        intFieldOrZero(request.resource.data, 'trustVerifiedTotal') + intFieldOrZero(request.resource.data, 'trustWrongTotal') ==
          intFieldOrZero(request.resource.data, 'trustTotalVotes') &&
        intFieldOrZero(request.resource.data, 'contributions') >= intFieldOrZero(resource.data, 'contributions') &&
        intFieldOrZero(request.resource.data, 'contributions') <= intFieldOrZero(resource.data, 'contributions') + 1;
    }

    function hasSafePriceHistoryMutation() {
      // The legacy `products.priceHistory` array is being phased out in favour
      // of the `priceReports` / `priceGroups` collections. Until the mirror
      // writes in PriceReportService are removed we still allow community
      // append + vote-update via this rule, but we constrain it tighter than
      // before:
      //   • Array can only grow by exactly 0 (vote update) or 1 (new entry).
      //   • Hard cap on array length so a single product doc can't blow past
      //     the Firestore 1MB doc limit (≈800 entries × 1.2KB each).
      //   • Newly appended entries must have the caller as `reportedByUid`,
      //     so a user can't impersonate someone else.
      return resource.data.priceHistory is list &&
        request.resource.data.priceHistory is list &&
        request.resource.data.priceHistory.size() >= resource.data.priceHistory.size() &&
        request.resource.data.priceHistory.size() <= resource.data.priceHistory.size() + 1 &&
        request.resource.data.priceHistory.size() <= 800 &&
        (
          // Vote case: same length, no impersonation check needed (transaction
          // enforces self-vote / duplicate-vote blocks).
          request.resource.data.priceHistory.size() == resource.data.priceHistory.size() ||
          // Append case: the new tail entry must belong to the caller.
          (
            request.resource.data.priceHistory[request.resource.data.priceHistory.size() - 1] is map &&
            request.resource.data.priceHistory[request.resource.data.priceHistory.size() - 1].reportedByUid ==
              request.auth.uid
          )
        );
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid) &&
        (!(request.resource.data.keys().hasAny(['uid'])) || request.resource.data.uid == uid) &&
        hasSafeUserCreateDefaults();

      allow update: if isAdmin() ||
        (
          isOwner(uid) &&
          hasOnlyUserWritableKeys() &&
          hasNoImmutableUserChanges() &&
          hasSafeProfileImageMutation(uid) &&
          hasSafeUserGamificationMutation()
        );

      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isAdmin() || isOwner(uid);
        allow update, delete: if isAdmin() || isOwner(uid);
      }

      match /productAlerts/{alertId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update, delete: if isAdmin() || isOwner(uid);
      }

      // Legacy migration read path
      match /inbox/{notificationId} {
        allow read: if isAdmin() || isOwner(uid);
        // Legacy compat: no new writes.
        allow create, update, delete: if false;
      }

      // Legacy NotificationCenter / PriceDropWatcher path
      match /inAppNotifications/{notificationId} {
        allow read: if isAdmin() || isOwner(uid);
        // Legacy compat: no runtime writes.
        allow create, update, delete: if false;
      }
    }

    // Legacy global notification docs used during migration.
    match /inAppNotifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // Legacy compat: no runtime writes.
      allow create, update, delete: if false;
    }

    // Legacy path used by older notification-center items.
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // Legacy compat: no runtime writes.
      allow create, update, delete: if false;
    }

    // Legacy path used by older notification-center items.
    match /notifications/{uid}/items/{itemId} {
      allow read: if isAdmin() || isOwner(uid);
      // Legacy compat: no runtime writes.
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin();
      // Admins can update anything. Signed-in community users can only touch
      // the `priceHistory` field (via addPrice / voteOnPrice transactions).
      // The client transaction enforces self-vote / duplicate-vote blocks.
      allow update: if isAdmin() || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priceHistory']) &&
        hasSafePriceHistoryMutation()
      );
      allow delete: if isAdmin();
    }

    // Community product suggestions. Users create their own pending requests;
    // only admins can approve / reject / hard-delete them.
    match /product_requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.requestedByUid == request.auth.uid &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
        (!('approvedProductId' in request.resource.data)) &&
        (!('rejectionReason' in request.resource.data)) &&
        (!('decidedAt' in request.resource.data));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /store_chains/{chainId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /store_places/{placeId} {
      function hasSafeStorePlaceRequestPayload() {
        return request.resource.data.keys().hasOnly([
          'chainId',
          'chainName',
          'type',
          'displayName',
          'normalizedName',
          'city',
          'district',
          'neighborhood',
          'lat',
          'lng',
          'status',
          'isActive',
          'usageCount',
          'legacyStoreId',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.type in ['chain_market', 'local_market', 'online_market', 'bazaar'] &&
        request.resource.data.displayName is string &&
        request.resource.data.normalizedName is string &&
        request.resource.data.city is string &&
        request.resource.data.district is string &&
        (!('neighborhood' in request.resource.data) || request.resource.data.neighborhood == null || request.resource.data.neighborhood is string) &&
        (!('lat' in request.resource.data) || request.resource.data.lat == null || request.resource.data.lat is number) &&
        (!('lng' in request.resource.data) || request.resource.data.lng == null || request.resource.data.lng is number) &&
        request.resource.data.usageCount == 0;
      }

      allow read: if true;
      // Community can only create pending place requests; moderation is admin-only.
      allow create: if signedIn() &&
        hasSafeStorePlaceRequestPayload() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.isActive == true &&
        request.resource.data.createdByUid == request.auth.uid &&
        (!('chainId' in request.resource.data) || request.resource.data.chainId == null || request.resource.data.chainId is string) &&
        (!('chainName' in request.resource.data) || request.resource.data.chainName == null || request.resource.data.chainName is string);
      allow update, delete: if isAdmin();
    }

    match /price_entries/{entryId} {
      function hasSafePriceEntryCreatePayload() {
        return request.resource.data.keys().hasOnly([
          'productId',
          'productNameSnapshot',
          'productBrandSnapshot',
          'price',
          'scope',
          'sourceType',
          'chainId',
          'chainName',
          'placeId',
          'placeDisplayName',
          'city',
          'district',
          'lat',
          'lng',
          'createdAt',
          'expiresAt',
          'reportedByUid',
          'reportedByName',
          'status',
          'upvotes',
          'downvotes',
          'voters',
          'trustWeightedScore',
          'note',
          'proofImageUrl',
          'legacy'
        ]) &&
        request.resource.data.productId is string &&
        ((request.resource.data.price is int) || (request.resource.data.price is float)) &&
        request.resource.data.sourceType in ['physical', 'online', 'bazaar'] &&
        request.resource.data.scope in ['local', 'city', 'online', 'bazaar'] &&
        request.resource.data.reportedByUid is string &&
        request.resource.data.reportedByName is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.upvotes == 0 &&
        request.resource.data.downvotes == 0 &&
        request.resource.data.trustWeightedScore == 0 &&
        request.resource.data.voters is map &&
        (!('chainId' in request.resource.data) || request.resource.data.chainId == null || request.resource.data.chainId is string) &&
        (!('chainName' in request.resource.data) || request.resource.data.chainName == null || request.resource.data.chainName is string) &&
        (!('placeId' in request.resource.data) || request.resource.data.placeId == null || request.resource.data.placeId is string) &&
        (!('city' in request.resource.data) || request.resource.data.city == null || request.resource.data.city is string) &&
        (!('district' in request.resource.data) || request.resource.data.district == null || request.resource.data.district is string) &&
        (!('note' in request.resource.data) || request.resource.data.note == null || request.resource.data.note is string) &&
        (!('proofImageUrl' in request.resource.data) || request.resource.data.proofImageUrl == null || request.resource.data.proofImageUrl is string);
      }

      allow read: if true;
      // Client create allowed for now; status/trust moderation remains admin-only.
      allow create: if signedIn() &&
        request.resource.data.reportedByUid == request.auth.uid &&
        hasSafePriceEntryCreatePayload();
      allow update, delete: if isAdmin();
    }

    match /price_summaries/{summaryId} {
      allow read: if true;
      // Write path should be Cloud Functions/admin jobs.
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /campaignProducts/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /campaignBaskets/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    function hasSafePriceReportCreatePayload() {
      return request.resource.data.keys().hasOnly([
        'productId',
        'entryId',
        'createdByUid',
        'price',
        'storeName',
        'reason',
        'chainId',
        'branchStoreId',
        'branchId',
        'reporterIsAnonymous',
        'status',
        'verificationStatus',
        'createdAt',
        'updatedAt'
      ]) &&
      ('productId' in request.resource.data) &&
      ('entryId' in request.resource.data) &&
      ('createdByUid' in request.resource.data) &&
      ('price' in request.resource.data) &&
      (request.resource.data.productId is string) &&
      (request.resource.data.entryId is string) &&
      (request.resource.data.createdByUid is string) &&
      ((request.resource.data.price is int) || (request.resource.data.price is float)) &&
      (!('storeName' in request.resource.data) || request.resource.data.storeName is string) &&
      (!('reason' in request.resource.data) || request.resource.data.reason is string) &&
      (!('chainId' in request.resource.data) || request.resource.data.chainId is string) &&
      (!('branchStoreId' in request.resource.data) || request.resource.data.branchStoreId is string) &&
      (!('branchId' in request.resource.data) || request.resource.data.branchId is string) &&
      (!('reporterIsAnonymous' in request.resource.data) || request.resource.data.reporterIsAnonymous is bool) &&
      (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) &&
      (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }


    function hasSafeRegionalPriceReportCreatePayload() {
      // hasAll → hasOnly so kötü niyetli istemci raporun yanına `isAdmin: true`
      // ya da serbest metadata ekleyemesin.
      return request.resource.data.keys().hasAll([
        'productId',
        'chainId',
        'cityId',
        'districtId',
        'price',
        'userId',
        'localDateKey'
      ]) &&
      request.resource.data.keys().hasOnly([
        'productId', 'productName',
        'chainId', 'chainName',
        'cityId', 'cityName',
        'districtId', 'districtName',
        'branchId', 'branchName',
        'price', 'currency',
        'sourceType', 'locationSource',
        'distanceToBranchMeters', 'gpsAccuracyMeters',
        'location', 'photoUrl', 'note', 'barcode',
        'userId', 'userDisplayName',
        'createdAt', 'updatedAt',
        'localDateKey', 'status', 'reviewReason', 'dedupeKey', 'groupId'
      ]) &&
      request.resource.data.productId is string &&
      request.resource.data.chainId is string &&
      request.resource.data.cityId is string &&
      request.resource.data.districtId is string &&
      ((request.resource.data.price is int) || (request.resource.data.price is float)) &&
      request.resource.data.price > 0 &&
      request.resource.data.userId is string &&
      request.resource.data.localDateKey is string;
    }

    match /priceReports/{priceId} {
      function hasOnlyPriceReportOwnerWritableKeys() {
        return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'price',
          'storeName',
          'chainId',
          'branchStoreId',
          'branchId',
          'reporterIsAnonymous',
          'updatedAt'
        ]);
      }

      allow get: if isAdmin() ||
        (signedIn() && priceId.matches('^' + request.auth.uid + '_.*'));
      allow list: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (
        (
          hasSafePriceReportCreatePayload() &&
          priceId == (request.auth.uid + '_' + request.resource.data.entryId) &&
          request.resource.data.createdByUid == request.auth.uid &&
          (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
          (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'unverified')
        ) || (
          hasSafeRegionalPriceReportCreatePayload() &&
          request.resource.data.userId == request.auth.uid &&
          (!('status' in request.resource.data) ||
            request.resource.data.status in ['active', 'pending_photo_review'])
        )
      );
      allow update: if isAdmin() || (
        signedIn() &&
        (
          (
            resource.data.createdByUid == request.auth.uid &&
            request.resource.data.createdByUid == resource.data.createdByUid &&
            request.resource.data.productId == resource.data.productId &&
            request.resource.data.entryId == resource.data.entryId &&
            hasOnlyPriceReportOwnerWritableKeys() &&
            hasSafePriceReportCreatePayload() &&
            (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
            (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == resource.data.verificationStatus)
          ) || (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            hasSafeRegionalPriceReportCreatePayload()
          )
        )
      );
      allow delete: if isAdmin();

      // Legacy vote documents.
      match /verifications/{voteUid} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin() || (signedIn() && voteUid == request.auth.uid);
      }
    }


    // Regional aggregation docs. Writes happen only inside the
    // PriceReportService transaction (alongside priceReports + dedupes).
    // We can't fully prevent client tampering without moving aggregation to
    // a Cloud Function (TODO: P1 onPriceReportCreate trigger), so we lock the
    // write surface to a known field whitelist + monotonically-rising
    // counters + the lastReporterId == auth.uid invariant. That blocks the
    // worst class of attacks (resetting verifiedCount to 0, slamming
    // trustedPrice to a fake value, deleting confidence).
    function priceGroupAllowedFields() {
      return [
        'productId', 'productName',
        'chainId', 'chainName',
        'cityId', 'cityName',
        'districtId', 'districtName',
        'latestPrice', 'trustedPrice', 'avgPrice',
        'minPrice', 'maxPrice',
        'reportCount', 'verifiedCount', 'photoReportCount',
        'lastReportedAt', 'lastReporterId',
        'confidence', 'sourceType',
        'displayTitle', 'updatedAt'
      ];
    }

    function priceGroupCounterMonotonic(field) {
      return !(field in resource.data) || (
        request.resource.data[field] is int &&
        request.resource.data[field] >= resource.data[field] &&
        request.resource.data[field] <= resource.data[field] + 1
      );
    }

    function hasSafePriceGroupPayload() {
      return request.resource.data.keys().hasOnly(priceGroupAllowedFields()) &&
        request.resource.data.lastReporterId == request.auth.uid &&
        (!('reportCount' in request.resource.data) || request.resource.data.reportCount is int) &&
        (!('verifiedCount' in request.resource.data) || request.resource.data.verifiedCount is int) &&
        (!('photoReportCount' in request.resource.data) || request.resource.data.photoReportCount is int) &&
        (!('latestPrice' in request.resource.data) || request.resource.data.latestPrice is number) &&
        (!('trustedPrice' in request.resource.data) || request.resource.data.trustedPrice is number) &&
        (!('avgPrice' in request.resource.data) || request.resource.data.avgPrice is number) &&
        (!('minPrice' in request.resource.data) || request.resource.data.minPrice is number) &&
        (!('maxPrice' in request.resource.data) || request.resource.data.maxPrice is number) &&
        (!('confidence' in request.resource.data) || request.resource.data.confidence in ['low', 'medium', 'high']);
    }

    match /priceGroups/{groupId} {
      allow read: if true;
      // First-write: any signed-in user may create (counter is presumed 0).
      allow create: if signedIn() &&
        hasSafePriceGroupPayload() &&
        (!('reportCount' in request.resource.data) || request.resource.data.reportCount == 1) &&
        (!('verifiedCount' in request.resource.data) || request.resource.data.verifiedCount == 0);
      // Updates: counters can grow by at most +1 per call (one report or one
      // verify at a time). Stops `verifiedCount: 99999` style attacks.
      allow update: if signedIn() &&
        hasSafePriceGroupPayload() &&
        priceGroupCounterMonotonic('reportCount') &&
        priceGroupCounterMonotonic('verifiedCount') &&
        priceGroupCounterMonotonic('photoReportCount') &&
        // chain/region/product identity must not be rewritten after creation.
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.chainId == resource.data.chainId &&
        request.resource.data.cityId == resource.data.cityId &&
        request.resource.data.districtId == resource.data.districtId;
      allow delete: if isAdmin();
    }

    // Dedupe ledger. Used to (a) detect same-day repeat submissions and
    // (b) hold the verifierUserIds map for the "ben de gördüm" flow.
    function hasSafePriceDedupePayload() {
      return request.resource.data.keys().hasOnly([
        'groupId', 'reportId', 'dedupeKey',
        'verifiedCount', 'verifierUserIds',
        'createdAt', 'updatedAt'
      ]) &&
      (!('verifiedCount' in request.resource.data) || request.resource.data.verifiedCount is int) &&
      (!('verifierUserIds' in request.resource.data) || request.resource.data.verifierUserIds is map);
    }

    // FiyatRadar Pro satın alma kuyruğu.
    // İstemci `PremiumService._enqueueForServerVerification` ile yazar:
    // doc id `${uid}_${productId}_${purchaseId}` → idempotent. Cloud
    // Function (`verifyPurchase`) Play Developer API üzerinden
    // doğrular ve `users/{uid}.isPremium` yazar; doc'u `consumed=true`
    // olarak işaretler. İstemci yalnız kendi prefix'ini okur/yazar.
    match /purchaseQueue/{purchaseDoc} {
      function purchaseAuthor() {
        return request.auth != null &&
          purchaseDoc.matches('^' + request.auth.uid + '_.*');
      }
      allow read: if isAdmin() || purchaseAuthor();
      allow create: if purchaseAuthor() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.consumed == false;
      // Update: yalnız admin (Cloud Function admin SDK ile yazar).
      allow update, delete: if isAdmin();
    }

    match /priceReportDedupes/{dedupeId} {
      allow read: if signedIn();
      // First write: caller marks themselves as a verifier for this dedupe.
      allow create: if signedIn() &&
        hasSafePriceDedupePayload() &&
        (!('verifiedCount' in request.resource.data) || request.resource.data.verifiedCount == 1) &&
        (!('verifierUserIds' in request.resource.data) ||
          (request.resource.data.verifierUserIds.keys().hasOnly([request.auth.uid]) &&
           request.resource.data.verifierUserIds[request.auth.uid] == true));
      // Updates: only +1 to verifiedCount and only adding self to map. Cannot
      // remove other users, cannot bulk-set a fake count.
      allow update: if signedIn() &&
        hasSafePriceDedupePayload() &&
        request.resource.data.dedupeKey == resource.data.dedupeKey &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.verifiedCount is int &&
        request.resource.data.verifiedCount >= resource.data.verifiedCount &&
        request.resource.data.verifiedCount <= resource.data.verifiedCount + 1 &&
        // Caller must not already be a verifier (no double-credit) AND must
        // be present in the new map.
        !(request.auth.uid in resource.data.verifierUserIds) &&
        request.resource.data.verifierUserIds[request.auth.uid] == true;
      allow delete: if isAdmin();
    }

    match /price_votes/{priceId}/votes/{voteUid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || (signedIn() && voteUid == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() &&
        hasSafeCommentCreatePayload() &&
        request.resource.data.userId == request.auth.uid &&
        hasSafeCommentCreateDefaults();
      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 500
        );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    function hasSafePointsEventPayload() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'eventType',
        'pointsDelta',
        'points',
        'meta',
        'createdAt'
      ]) &&
      ('userId' in request.resource.data) &&
      ('eventType' in request.resource.data) &&
      ('pointsDelta' in request.resource.data) &&
      ('createdAt' in request.resource.data) &&
      (request.resource.data.userId is string) &&
      (request.resource.data.eventType is string) &&
      (request.resource.data.pointsDelta is int) &&
      (request.resource.data.createdAt is timestamp) &&
      (!('meta' in request.resource.data) || request.resource.data.meta is map) &&
      (!('points' in request.resource.data) ||
        ((request.resource.data.points is int) && request.resource.data.points == request.resource.data.pointsDelta));
    }

    match /points_events/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() && hasSafePointsEventPayload();
      allow update, delete: if isAdmin();
    }

    function hasSafeAdminActionCreatePayload() {
      return request.resource.data.keys().hasOnly([
        'actorUid',
        'action',
        'targetUid',
        'targetId',
        'reason',
        'meta',
        'createdAt'
      ]) &&
      ('actorUid' in request.resource.data) &&
      ('action' in request.resource.data) &&
      ('createdAt' in request.resource.data) &&
      (request.resource.data.action is string) &&
      (request.resource.data.createdAt is timestamp) &&
      (!('targetUid' in request.resource.data) || request.resource.data.targetUid is string) &&
      (!('targetId' in request.resource.data) || request.resource.data.targetId is string) &&
      (!('reason' in request.resource.data) || request.resource.data.reason is string) &&
      (!('meta' in request.resource.data) || request.resource.data.meta is map) &&
      request.resource.data.action.size() > 0;
    }

    match /adminActions/{doc} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.actorUid == request.auth.uid &&
        hasSafeAdminActionCreatePayload();
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        (
          (!('reporterUserId' in request.resource.data)) ||
          request.resource.data.reporterUserId == request.auth.uid
        ) &&
        (
          (!('reporterUid' in request.resource.data)) ||
          request.resource.data.reporterUid == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }


    match /special_lists/{listId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /items/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /users/{uid}/favorites/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/watchlist/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/followedProducts/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/recently_viewed/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/searchHistory/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/basketItems/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/cartItems/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/receipts/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/points_log/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid}/points_daily/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/points_summary/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/trust_daily/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/trust_events/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
