rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Users can read/write their own profile picture only.
    match /user_profiles/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Product images: world-readable (used in lists). Writes require admin.
    match /product_images/{productId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Banner hero / blog images: same rule set as product images.
    match /banner_images/{bannerId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
